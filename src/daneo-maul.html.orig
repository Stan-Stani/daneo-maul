 {id:'fixer',name:'수리 기사',x:21,y:4,dir:'left',look:{hair:'#5A3A22',skin:'#D9A47A',shirt:'#4F7BD6',pants:'#3A3A48',cap:'#E9A23B'},badge:['고장 나다','수리하다','대체하다'],
