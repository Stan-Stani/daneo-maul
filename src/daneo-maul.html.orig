 {id:'rival',name:'라이벌',x:20,y:15,dir:'left',still:1,look:{hair:'#C0582E',skin:'#F1C9A5',shirt:'#4F7BD6',pants:'#2E3548',cap:'#2E3548'},badge:['상대','기술','공격'],
