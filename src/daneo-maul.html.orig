},
 things:{
 T:sayAt(...TREES),
 L:sayAt('도서관 벽이에요. 안에서 책 냄새가 나요. 📚','도서관이에요. 안은 아주 조용해요. 🤫','창문 안에 책장이 많아요.'),
 C:sayAt('카페 벽이에요. 커피 냄새가 나요. ☕','창문으로 맛있는 케이크가 보여요. 🍰','카페 안에서 사람들이 이야기해요.'),
 W:sayAt('안에서 세탁기 소리가 들려요. 윙윙~','깨끗한 옷 냄새가 나요. 🧺','창문이 따뜻해요. 안에 세탁기가 많아요.'),
 k:()=>[{say:'책이 많아요. 빌리고 싶으면 사서한테 말해요.'}],
 e:()=>[{say:'누가 시험 공부를 하고 있어요. 조용히… 🤫'}],
 c:()=>[{say:'카운터예요. 커피 냄새가 좋아요.'}],
 K:()=>[{say:'케이크가 있어요. 🍰 먹고 싶어요… 그런데 참아요!'}],
 D:()=>[{say:'노트북이에요. 화면에 작은 게임이 있어요. 🎮'}],
 w:()=>[{say:'세탁기가 돌아가요. 윙윙~ 빨래 중이에요.'}],
 f:()=>[{say:'집을 짓고 있어요. 아직 벽이 없어요.'}],
 '#':()=>[{say:'벽돌이 무거워요. 혼자 들 수 있어요? 💪'}],
 '~':sayAt('연못이에요. 누가 책을 떨어뜨렸어요! 연체료보다 더 큰일이에요. 📕💦','오리가 조용히 헤엄쳐요. 도서관 옆이라서 오리도 조용해요. 🤫🦆'),
 n:()=>{
  if(state.book==='have') return [
   {say:'벤치에 앉아서 책을 읽어요… 📖'},
   {say:'…페이지를 넘겨요… 피카츄가 바다를 건너요!'},
   {say:'다 읽었어요! 이제 사서한테 반납해야 돼요.',set:()=>{state.book='read'}}];
  if(state.book==='none') return [{say:'연못 옆 벤치예요. 책 읽기 좋은 곳이에요.'}];
  return [{say:'벤치에 앉아서 연못을 봐요. 평화로워요.'}];
 },
 },

 npcs:[
 {id:'librarian',name:'사서',x:6,y:4,dir:'down',look:{hair:'#4A3428',skin:'#F1C9A5',shirt:'#5B8BD9',pants:'#3A3F55',long:1},badge:['빌리다','반납하다'],
  after:'책 또 빌리러 오세요. 조용히~ 🤫',
  pool:[...LB,...LR],
  status:()=>state.book==='have'?'wait':undefined,
  script:()=>{
   if(state.book==='none') return [
    {say:'어서 오세요. 여기는 도서관이에요. 📚'},
    {say:'오늘 재미있는 책이 있어요. 「피카츄의 여행」이에요.'},
    LB[0],LB[1],
    {say:'여기 있어요! 책을 빌렸어요.',award:['빌리다'],set:()=>{state.book='have';state.steps=0;state.late=false}},
    {say:`반납일은 ${LIMIT}걸음 후예요. 늦으면 연체료가 있어요!`},
    {say:'안에는 시험 공부하는 사람이 많아요. 연못 옆 벤치에서 읽으세요.'}];
   if(state.book==='have') return [{say:state.late?'반납일이 벌써 지났어요! 빨리 벤치에서 읽고 오세요.':`아직 다 안 읽었어요? 연못 옆 벤치에서 읽으세요. 반납일까지 ${left()}걸음 남았어요.`}];
   if(state.book==='read'){
    const s=[{say:'책을 다 읽었어요? 재미있었어요?'}];
    if(state.late) s.push({say:'어… 그런데 반납일이 지났어요! 😅'},LR[2],{say:'괜찮아요. 이번만 봐 드릴게요.'});
    s.push(LR[0],LR[1]); if(!state.late) s.push(LR[2]);
    s.push({say:'반납 완료! 감사합니다.',award:['반납하다'],set:()=>{state.book='returned'}});
    return s;}
   return null;
  }},
 {id:'minji',name:'민지',x:8,y:10,dir:'up',look:{hair:'#2B1E1A',skin:'#F3D0B0',shirt:'#E07A5F',pants:'#3D5A80',long:1},badge:['돌려주다'],
  after:'CD 고마워요! 다음엔 제가 게임 빌려줄게요.',
  talk:[
   {say:'아, 안녕하세요!'},
   {say:'지난주에 제 게임 CD 빌려 갔죠? 😄'},
   {ask:'친구한테 빌린 물건은 친구한테 ___.',opts:[['돌려줘요',1],['돌아가요',0,'"돌아가다"는 사람이 가요. "집에 돌아가요." 물건은 "돌려줘요".'],['빌려요',0,'벌써 빌렸어요! 이제 다시 줘요 → "돌려줘요".']]},
   {ask:'친구한테는 "반납"보다 "돌려주다"가 자연스러워요. 왜요?',opts:[['반납은 도서관 같은 곳에 해요.',1],['반납은 음식이에요.',0,'😄 아니요! 반납은 도서관, 회사 같은 곳에 돌려주는 거예요.']]},
   {ask:'내일 CD를 ___ 거예요.',opts:[['돌려줄',1],['돌아줄',0,'"돌아주다"는 없어요. 돌려주다 → "돌려줄 거예요"!'],['반납할',0,'친구한테는 좀 딱딱해요. "돌려줄 거예요"가 자연스러워요.']]},
   {say:'좋아요! 내일 봐요~',award:['돌려주다']}]},
 {id:'laundry',name:'빨래방 사장님',x:4,y:16,dir:'up',look:{hair:'#8A8A93',skin:'#E8B98F',shirt:'#6FB7B1',pants:'#3A3A48'},badge:['빨래'],
  after:'빨래 끝나면 잘 개세요~',
  talk:[
   {say:'어서 오세요! 여기는 빨래방이에요.'},
   {say:'간판에는 "세탁"을 많이 써요. 그런데 말할 때는 "빨래"를 많이 써요.'},
   {ask:'"주말에 뭐 했어요?" 가장 자연스러운 대답은?',opts:[['주말에 빨래했어요.',1],['주말에 세탁했어요.',0,'틀린 건 아니에요! 그런데 말할 때는 "빨래했어요"가 더 자연스러워요.']]},
   {ask:'"빨래"는 순 한국어예요. "세탁"은?',opts:[['한자어',1],['순 한국어',0,'세탁(洗濯)은 한자에서 왔어요. 그래서 한자어예요.']]},
   {ask:'"빨래가 많아요." 여기서 빨래는 뭐예요?',opts:[['빨 옷',1],['빨래하는 행동',0,'"빨래해요"는 행동이에요. "빨래가 많아요"는 빨 옷이에요.']]},
   {ask:'옷을 맡기는 가게는 ___예요.',opts:[['세탁소',1],['빨래소',0,'"빨래소"는 없어요. 가게랑 기계는 "세탁소", "세탁기"처럼 한자어를 써요.']]},
   {say:'완벽해요! 빨래 끝!',award:['빨래']}]},
 {id:'owner',name:'카페 사장님',x:16,y:3,dir:'down',look:{hair:'#3B2A22',skin:'#E8B98F',shirt:'#F4F4F4',pants:'#6B4A2B',belt:'#6B4A2B'},badge:['조합','어울리다'],
  after:'오늘 커피하고 쿠키가 잘 어울려요. ☕',
  talk:[
   {say:'어서 오세요! 오늘의 새 메뉴가 있어요.'},
   {say:'밥, 콩, 치즈! 같이 섞어서 만들었어요.'},
   {w:'조합',ask:'밥하고 콩하고 치즈를 ___해서 만들었어요.',opts:[['조합',1],['구현',0,'구현은 생각을 진짜로 만드는 거예요. 여러 개를 같이 → "조합".'],['중립',0,'중립은 편을 안 드는 거예요. 여러 개를 같이 → "조합".']]},
   {w:'어울리다',ask:'커피하고 단 간식은 잘 ___.',opts:[['어울려요',1],['어울리다',0,'"어울리다"는 사전 모양이에요. 말할 때는 "어울려요".'],['조합해요',0,'"잘 조합해요"는 어색해요. 같이 있으면 좋아요 → "잘 어울려요".']]},
   {w:'어울리다',ask:'"이 모자가 잘 어울려요." 무슨 뜻이에요?',opts:[['모자가 나한테 좋아 보여요.',1],['모자를 섞었어요.',0,'섞는 건 "조합"이에요. 어울리다 = 같이 있으면 좋아 보여요.']]},
   {say:'좋아요! 커피 한 잔 드릴게요. ☕',award:['조합','어울리다']}]},
 {id:'diet',name:'손님 하나',x:18,y:4,dir:'down',look:{hair:'#C0582E',skin:'#F3D0B0',shirt:'#F2C94C',pants:'#3D5A80',long:1},badge:['참다'],
  after:'(입에 케이크가 있어요.) 음… 내일부터 참을 거예요! 🍰',
  talk:[
   {say:'음… 이 케이크… 너무 맛있어 보여요.'},
   {say:'그런데 저는 다이어트 중이에요.'},
   {ask:'케이크를 먹고 싶어요. 그런데 안 먹어요. 케이크를 ___.',opts:[['참아요',1],['견뎌요',0,'견디다는 힘든 걸 오래 버텨요. 하고 싶은 걸 안 해요 → "참다".'],['돌려줘요',0,'😄 케이크를 누구한테 돌려줘요? 안 먹어요 → "참아요".']]},
   {ask:'도서관이에요. 웃고 싶어요. 그런데 조용해야 돼요.',opts:[['웃음을 참아요.',1],['웃음을 반납해요.',0,'😄 웃음은 반납할 수 없어요! 하고 싶은 걸 안 해요 → "참아요".']]},
   {ask:'"참다"는 꼭 슬플 때만 써요?',opts:[['아니요, 좋은 것도 참아요.',1],['네, 슬플 때만 써요.',0,'아니에요! 케이크처럼 좋은 것도 참아요.']]},
   {say:'…아니, 못 참겠어요! 한 입만! 🍰',award:['참다']}]},
 {id:'dev',name:'게임 개발자',x:20,y:6,dir:'up',look:{hair:'#2A2F4A',skin:'#F1C9A5',shirt:'#3FA86B',pants:'#2E3548'},badge:['개선하다'],
  after:'초록 얼굴 경고를 넣었어요! 이제 다들 이해해요. 🎮',
  talk:[
   {say:'안녕하세요! 저는 작은 게임을 만들어요. 🎮'},
   {say:'캐릭터가 같은 과일을 너무 많이 먹으면 토해요.'},
   {say:'그런데 사람들이 잘 이해를 못 해요. 😢'},
   {ask:'그래서 게임을 더 좋게 만들 거예요. 게임을 ___할 거예요.',opts:[['개선',1],['반납',0,'게임을 도서관에 가져가요? 😄 더 좋게 → "개선".'],['중립',0,'중립은 편을 안 드는 거예요. 더 좋게 → "개선".']]},
   {ask:'토하기 전에 미리 알려주면 어때요? 그건 ___예요.',opts:[['경고',1],['연체료',0,'연체료는 늦게 반납하면 내는 돈이에요! 미리 알려주는 건 "경고".'],['조합',0,'조합은 섞는 거예요. 미리 알려주는 건 "경고".']]},
   {ask:'게임에 버그가 있어요. 안 돼요. 버그를 ___.',opts:[['고쳐요',1],['개선해요',0,'고장 난 건 "고치다". 괜찮은 걸 더 좋게 → "개선하다".']]},
   {say:'글자 말고 그림으로 경고할 거예요. 캐릭터 위에 작은 초록 얼굴!'},
   {say:'고마워요! 계속 연습하면 한국어 실력도 개선될 거예요.',award:['개선하다']}]},
 {id:'worker',name:'인부 아저씨',x:16,y:15,dir:'left',still:1,look:{hair:'#5A3A22',skin:'#D9A47A',shirt:'#E9A23B',pants:'#3A3A48',cap:'#F2C94C'},badge:['견디다'],
  after:'조금만 더 견디면 집이 완성돼요!',
  talk:[
   {say:'휴… 저는 집을 짓고 있어요.'},
   {ask:'저는 집을 ___ 있어요.',opts:[['짓고',1],['짖고',0,'😄 "짖다"는 강아지가 멍멍 해요! 집은 "짓다".']]},
   {say:'오늘은 너무 더워요. 그리고 많이 피곤해요.'},
   {ask:'피곤해도 일을 ___.',opts:[['견뎌야 돼요',1],['반납해야 돼요',0,'일은 반납 못 해요! 😄 힘든 걸 버텨요 → "견뎌야 돼요".'],['어울려야 돼요',0,'어울리다는 같이 있으면 좋은 거예요. 힘든 걸 버텨요 → "견디다".']]},
   {ask:'파고의 겨울은 길고 추워요. 몇 달 동안 추위를 ___.',opts:[['견뎌요',1],['조합해요',0,'추위를 섞어요? 😄 힘든 걸 오래 버텨요 → "견뎌요".']]},
   {ask:'"견디다"는 뭐예요?',opts:[['힘든 시간을 끝까지 버텨요.',1],['케이크를 안 먹어요.',0,'그건 "참다"예요! 견디다는 힘든 걸 오래 버티는 거예요.']]},
