<script>
/* =====================================================================
   카트리지 2편 · 도서관과 카페
   Content only — the engine draws, moves and runs dialogue. (Format notes: see 1편.)
   This one adds a side quest: borrow a book, read it on the bench, return it within {LIMIT} steps.
   ===================================================================== */
(()=>{
const LIMIT=80; // steps until the library book is due
const left=()=>Math.max(0,LIMIT-state.steps);
/* library questions (shared by the librarian's two visits and by review) */
const LB=[
 {w:'빌리다',ask:'책을 가져가요. 나중에 다시 가져와요. 책을 ___.',opts:[['빌려요',1],['빌려줘요',0,'"빌려주다"는 제가 해요! 사서는 빌려줘요. 손님은 "빌려요".'],['반납해요',0,'반납은 다시 가져올 때예요. 가져갈 때는 "빌리다".']]},
 {w:'빌리다',ask:'손님은 책을 빌려요. 사서는 책을 ___.',opts:[['빌려줘요',1],['빌려요',0,'주는 사람은 "빌려주다"예요. 빌리다 ↔ 빌려주다.']]},
];
const LR=[
 {w:'반납하다',ask:'다 읽은 책을 도서관에 다시 가져와요. 책을 ___.',opts:[['반납해요',1],['빌려요',0,'빌리는 건 가져갈 때예요. 다시 가져오면 "반납해요".'],['돌아가요',0,'"돌아가다"는 사람이 가는 거예요. 책은 "반납해요"!']]},
 {w:'반납하다',ask:'책을 돌려줘야 하는 날은 ___이에요.',opts:[['반납일',1],['생일',0,'😄 생일은 태어난 날이에요. 책을 돌려주는 날은 "반납일".']]},
 {w:'반납하다',ask:'반납일이 지나면 돈을 내요. 그 돈은 ___예요.',opts:[['연체료',1],['반납일',0,'반납일은 날짜예요. 늦으면 내는 돈은 "연체료".'],['조합',0,'조합은 섞는 거예요! 늦으면 내는 돈은 "연체료".']]},
];


CARTRIDGES.push({
 id:'c2', n:'2편', title:'도서관과 카페', color:'#5B8BD9', save:'daneo-maul-v2',
 words:[['빌리다','to borrow'],['반납하다','to return (library)'],['돌려주다','to give back'],['빨래','laundry'],['참다','to hold back'],['견디다','to endure'],['조합','combination'],['어울리다','to go well together'],['구현','realization'],['개선하다','to improve'],['중립적','neutral']],
 start:{x:10,y:9,dir:'down'},
 fresh:{book:'none',steps:0,late:false},
 help:'사람 앞에서 <b>A</b>. 머리 위 <span class="k">!</span> 새 단어 · <span class="k">?</span> 복습해서 <span class="k">★</span> 받기',
 tips:['책을 <b>빌리다</b> ↔ 책을 <b>빌려주다</b>','도서관에 <b>반납해요</b> · 친구한테 <b>돌려줘요</b>','<b>돌아가다</b>는 사람이 가요 · <b>돌려주다</b>는 물건을 줘요','<b>참다</b>: 하고 싶은 걸 안 해요 · <b>견디다</b>: 힘든 걸 버텨요','<b>고치다</b>: 고장 난 걸 · <b>개선하다</b>: 더 좋게','집을 <b>짓다</b> · 강아지가 <b>짖다</b>'],
 intro:['단어 마을에 새 이웃들이 이사 왔어요!','도서관, 카페, 빨래방, 공사장… 사람들한테 가서 A 버튼으로 말해요.','! 가 있는 사람한테 배지가 있어요. 한 번에 다 맞히면 ★ 예요.','도서관 책은 반납일이 있어요. 늦으면 연체료! 📕'],
 done:['축하해요! 배지 열한 개를 다 모았어요! 🎉','빌리다, 반납하다, 돌려주다, 빨래, 참다, 견디다, 조합, 어울리다, 구현, 개선하다, 중립적!','머리 위에 ? 가 있는 사람한테 다시 말해 보세요. 한 번에 맞히면 ★ 예요.'],
 perfect:['★ 열한 개! 모든 단어가 완벽해요!','오늘 한국어 실력이 많이 개선됐어요. 잘 견뎠어요! 💪'],

 /* side quest hooks */
 onStep(){
  if(state.book==='have'||state.book==='read'){
   state.steps++;
   if(state.steps>=LIMIT&&!state.late){state.late=true;toast('반납일이 지났어요! 😱');sfx('no')}
  }
 },
 quest(){
  if(state.book==='have')return {late:state.late,text:state.late?'📕 반납일이 지났어요! 벤치에서 읽고 빨리 반납해요.':`📕 연못 옆 벤치에서 책을 읽어요 · 반납일까지 ${left()}걸음`};
  if(state.book==='read')return {late:state.late,text:state.late?'📕 반납일이 지났어요! 빨리 사서한테 반납해요.':`📕 다 읽었어요! 사서한테 반납해요 · ${left()}걸음 남았어요`};
  return null;
 },

