<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>단어 마을</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=Gowun+Dodum&display=swap">
<style>
/* Layout: handheld-console look. Header (title, cartridge, sound, badges), quest strip, pixel map with RPG text box overlaid, D-pad + A/B below.
   Single deliberate look (night console shell), so colors are fixed rather than theme-switched. */
:root{
  color-scheme:dark;
  --shell:#1E2433; --shell-2:#283044; --edge:#3A4560; --ink:#F1F3F8; --muted:#A5AEC4;
  --box:#FBFAF4; --box-ink:#1F2433; --box-edge:#2B3246; --box-muted:#5A6380; --accent:#F2C94C; --accent-ink:#2A2210;
  --card:#fff; --a:#D9544B; --b:#4F7BD6; --got:#FFF6D8; --gotedge:#E0B43A; --seen:#E6ECF8; --seenedge:#9FB3DD; --off:#CCD1DE; --offink:#9AA1B4;
  --display:"Do Hyeon","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --body:"Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
}/* dark mode for the dialogue box and sheets: follows the device, and claude.ai's own theme switch */
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--box:#262D3F;--card:#30384D;--box-ink:#EEF1F7;--box-edge:#4A5677;--box-muted:#A3ACC4;--got:#3A3320;--gotedge:#C9A13A;--seen:#2B3550;--seenedge:#6E86BD;--off:#333A4C;--offink:#8C93A6}}
:root[data-theme="dark"]{--box:#262D3F;--card:#30384D;--box-ink:#EEF1F7;--box-edge:#4A5677;--box-muted:#A3ACC4;--got:#3A3320;--gotedge:#C9A13A;--seen:#2B3550;--seenedge:#6E86BD;--off:#333A4C;--offink:#8C93A6}

[hidden]{display:none!important}
html,body{height:100%;margin:0}
body{background:var(--shell);color:var(--ink);font-family:var(--body);-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
button{-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
.wrap{max-width:480px;margin:0 auto;padding:0 16px;padding-block:12px 20px;display:flex;flex-direction:column;gap:10px;box-sizing:border-box}
header{display:flex;justify-content:space-between;align-items:center;gap:8px}
h1{margin:0;font-family:var(--display);font-weight:400;font-size:1.45rem;letter-spacing:.03em;white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis}
.hbtns{display:flex;gap:6px;align-items:center}
.pill{font-family:var(--display);font-size:1rem;background:var(--shell-2);color:var(--muted);border:2px solid var(--edge);border-radius:999px;padding:6px 11px;cursor:pointer;white-space:nowrap;font-variant-numeric:tabular-nums}
.cartbtn{position:relative;width:44px;height:38px;padding:0;border:2px solid #1B1E2B;border-radius:5px 5px 3px 3px;cursor:pointer;
  background:linear-gradient(#0000 0 7px,var(--cart,#888) 7px);box-shadow:inset 0 -5px 0 rgba(0,0,0,.25),0 2px 0 #11141d;transition:transform .12s}
.cartbtn::before{content:"";position:absolute;left:6px;right:6px;top:2px;height:4px;background:repeating-linear-gradient(90deg,#9AA3B5 0 2px,#0000 2px 4px);border-radius:1px}
.cartbtn .cl{position:absolute;left:4px;right:4px;top:10px;bottom:7px;display:flex;align-items:center;justify-content:center;background:#FBFAF4;color:#1F2433;border-radius:2px;font-family:var(--display);font-size:.85rem;line-height:1}
.cartbtn:hover,.cartbtn:focus-visible{transform:translateY(-2px)}
.cartbtn:active{transform:translateY(2px)}
.pill.badge{color:var(--accent)}
@media (max-width:440px){.hbtns{gap:4px}.pill{padding:6px 7px;font-size:.9rem}}
.pill[aria-pressed="true"]{color:var(--accent)}
button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

.quest{font-family:var(--display);font-size:1rem;background:var(--shell-2);border:2px dashed var(--edge);color:var(--ink);border-radius:8px;padding:6px 12px;line-height:1.35;font-variant-numeric:tabular-nums}
.quest.late{border-color:var(--a);color:#FFD7D3}

.screen{position:relative;border:4px solid var(--edge);border-radius:10px;overflow:hidden;background:#000;line-height:0}
canvas{display:block;width:100%;height:auto;image-rendering:pixelated;image-rendering:crisp-edges;max-width:100%}

.dlg{position:absolute;left:6px;right:6px;bottom:6px;line-height:1.45;background:var(--box);color:var(--box-ink);border:3px solid var(--box-edge);border-radius:8px;box-shadow:inset 0 0 0 3px #D9DCE6;padding:10px 14px 12px;display:flex;flex-direction:column;gap:8px;max-height:calc(100% - 12px);overflow:auto;box-sizing:border-box}
.who{font-family:var(--display);font-size:.95rem;color:var(--box-muted);letter-spacing:.04em;display:flex;gap:8px;align-items:center}
.who .tag{font-size:.75rem;background:var(--seen);border:1px solid var(--seenedge);color:var(--box-ink);border-radius:999px;padding:0 8px}
.txt{font-family:var(--display);font-size:1.22rem;min-height:1.45em;word-break:keep-all}
.more{align-self:flex-end;font-size:.8rem;color:var(--box-muted);animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.choices{display:flex;flex-direction:column;gap:6px}
.choice{font-family:var(--display);font-size:1.12rem;text-align:left;background:var(--card);color:var(--box-ink);border:2px solid var(--box-edge);border-radius:6px;padding:8px 12px;cursor:pointer;word-break:keep-all}
.choice::before{content:"▸ ";color:var(--a);visibility:hidden}
.choice:active{background:#EEF1F8}
.choice.sel{background:var(--got);border-color:var(--a);box-shadow:0 0 0 2px var(--a)}
.choice.sel::before{visibility:visible}

.toast{position:absolute;left:50%;top:10px;transform:translateX(-50%);line-height:1.3;background:var(--accent);color:var(--accent-ink);font-family:var(--display);font-size:1.05rem;padding:6px 14px;border-radius:999px;border:2px solid var(--accent-ink);white-space:nowrap;max-width:92%;overflow:hidden;text-overflow:ellipsis}

.pad{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-top:4px;touch-action:none}
.dpad{display:grid;grid-template-columns:repeat(3,56px);grid-template-rows:repeat(3,56px)}
.dpad button{background:var(--shell-2);border:2px solid var(--edge);color:var(--muted);font-size:1.2rem;cursor:pointer;touch-action:none}
.dpad .u{grid-column:2;grid-row:1;border-radius:10px 10px 0 0}
.dpad .l{grid-column:1;grid-row:2;border-radius:10px 0 0 10px}
.dpad .c{grid-column:2;grid-row:2;background:var(--shell-2)}
.dpad .r{grid-column:3;grid-row:2;border-radius:0 10px 10px 0}
.dpad .d{grid-column:2;grid-row:3;border-radius:0 0 10px 10px}
.dpad button.on{background:var(--edge);color:var(--ink)}
.ab{display:flex;gap:14px;align-items:flex-end;transform:rotate(-18deg)}
.ab button{width:66px;height:66px;border-radius:50%;font-family:var(--display);font-size:1.5rem;color:#fff;border:3px solid rgba(0,0,0,.35);cursor:pointer;touch-action:none}
.ab .A{background:var(--a);margin-bottom:22px}
.ab .B{background:var(--b)}
.ab button:active{filter:brightness(.85)}
.help{font-size:.88rem;color:var(--muted);text-align:center;line-height:1.6}
.help b{color:var(--ink)}
.help .k{display:inline-block;min-width:1.2em;padding:0 5px;border-radius:4px;background:var(--shell-2);border:1px solid var(--edge);font-family:var(--display);color:var(--accent)}

.panel{position:fixed;inset:0;background:rgba(10,12,20,.78);display:flex;align-items:center;justify-content:center;padding:16px;z-index:5}
.sheet{background:var(--box);color:var(--box-ink);border:3px solid var(--box-edge);border-radius:12px;max-width:440px;width:100%;max-height:90%;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:10px;box-sizing:border-box}
.sheet h2{margin:0;font-family:var(--display);font-weight:400;font-size:1.5rem}
.legend{font-size:.82rem;color:var(--box-muted);margin:0;line-height:1.5}
.blist{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.bd{border:2px solid var(--off);border-radius:10px;padding:8px 6px;text-align:center;display:flex;flex-direction:column;gap:2px;min-width:0}
.bd .w{font-family:var(--display);font-size:1.12rem;word-break:keep-all}
.bd .m{font-size:.72rem;color:var(--box-muted);display:none}
#panel.en .bd .m{display:block}
.sheet h2{display:flex;justify-content:space-between;align-items:center}
.qbtn{width:30px;height:30px;border-radius:50%;border:2px solid var(--box-edge);background:var(--card);color:var(--box-ink);font-family:var(--display);font-size:1rem;cursor:pointer;line-height:1}
#panel.en .qbtn{background:var(--box-edge);color:#fff}
.gloss{position:absolute;left:10px;right:10px;top:8px;z-index:4;line-height:1.45;background:var(--accent);color:var(--accent-ink);border:3px solid var(--box-edge);border-radius:8px;padding:8px 46px 9px 12px;font-size:.95rem;display:flex;flex-direction:column;gap:4px;box-sizing:border-box}
.gloss b{font-family:var(--display);font-weight:400;font-size:1.1rem;margin-right:6px}
.gloss .en{font-size:.78rem;opacity:.8;display:block}
.gloss .q{position:absolute;right:8px;top:8px;width:28px;height:28px;border-radius:50%;border:2px solid var(--accent-ink);background:transparent;color:var(--accent-ink);font-family:var(--display);cursor:pointer;line-height:1}
.txt .w{cursor:pointer;border-radius:3px}
.talksheet{height:min(78vh,640px)}
.talklog{flex:1;overflow:auto;display:flex;flex-direction:column;gap:10px;border:2px solid var(--box-edge);border-radius:8px;padding:10px 12px;background:var(--card);line-height:1.5}
.tl{display:flex;flex-direction:column;gap:1px}
.tl .tw{font-family:var(--display);font-size:.85rem;color:var(--box-muted)}
.tl .tt{font-family:var(--display);font-size:1.08rem;word-break:keep-all}
.startrow{display:flex;justify-content:center;padding-top:8px}
.start{font-family:var(--display);font-size:.8rem;letter-spacing:.12em;background:var(--shell-2);color:var(--muted);border:2px solid var(--edge);border-radius:999px;padding:6px 18px;cursor:pointer;transform:rotate(-18deg)}
.start:active{transform:rotate(-18deg) translateY(2px)}
.games{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:4px}.games span{font-size:.8rem;opacity:.7;width:100%}.games a{font-weight:700;font-size:.92rem;color:inherit;border:2px dashed currentColor;border-radius:8px;padding:5px 10px;text-decoration:none;opacity:.85}
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.mi{font-family:var(--display);font-size:1.1rem;padding:14px 10px;border-radius:10px;border:2px solid var(--box-edge);background:var(--card);color:var(--box-ink);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px}
.mi.wide{grid-column:1/-1}.mi[hidden]{display:none}
.mi.toggle::after{content:' · 꺼짐';opacity:.65}.mi.toggle[aria-pressed="true"]::after{content:' · 켜짐'}
.mi.toggle[aria-pressed="true"]{background:var(--box-edge);color:#fff}
.cartmi .cartbtn{pointer-events:none}
.srclist{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px}
.srclist a{color:var(--box-ink);font-family:var(--display);font-size:1.05rem;text-decoration:underline;text-underline-offset:3px}
.srclist small{display:block;color:var(--box-muted);font-size:.8rem;margin-top:2px}
.tapsort{display:flex;gap:6px}.tapsort .btn{padding:4px 12px;font-size:.9rem}.tapsort .btn.on{background:var(--box-edge);color:#fff}
#tapCount{font-size:.9rem;color:var(--box-muted)}
.tp{display:flex;flex-direction:column;gap:2px;cursor:pointer;padding-bottom:8px;border-bottom:1px solid rgba(0,0,0,.1)}
.tph{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.tph b{font-family:var(--display);font-weight:400;font-size:1.2rem}
.tpm{font-size:.78rem;color:var(--box-muted);white-space:nowrap}.tpk{word-break:keep-all}.tpe{font-size:.9rem;color:var(--box-muted)}
.tl-empty{color:var(--box-muted);margin:0}
body.talkopen .gloss{position:fixed;top:calc(env(safe-area-inset-top,0px) + 14px);left:50%;transform:translateX(-50%);width:min(440px,calc(100% - 32px));z-index:20}
.txt .w.hint{background:rgba(242,201,76,.35);box-shadow:0 0 0 2px rgba(242,201,76,.6);animation:tapPulse 1.3s ease-in-out infinite}
@keyframes tapPulse{50%{background:rgba(242,201,76,.75)}}
.gloss .gx{display:none;position:absolute;right:42px;top:8px;width:28px;height:28px;border-radius:50%;border:0;background:rgba(0,0,0,.18);color:inherit;font-size:1.1rem;line-height:1;cursor:pointer}
.gloss.pinned .gx{display:block}.gloss.pinned{padding-right:82px}.gloss.pinned{outline:3px solid rgba(0,0,0,.25);outline-offset:-3px}
.gloss .q.pulse{animation:qPulse 1.2s ease-in-out infinite}
@keyframes qPulse{50%{transform:scale(1.18);box-shadow:0 0 0 4px rgba(31,36,51,.25)}}
.taptip{display:inline-block;margin-left:6px;vertical-align:2px;font-size:.72rem;line-height:1.5;background:var(--box-edge);color:#fff;border-radius:999px;padding:0 8px;font-family:var(--display);pointer-events:none}
@media (prefers-reduced-motion: reduce){.txt .w.hint,.gloss .q.pulse{animation:none}}
.txt .w:active{background:rgba(242,201,76,.45)}
.bd .s{font-size:1.1rem;line-height:1;font-family:var(--display)}
.bd.got{border-color:var(--seenedge);background:var(--seen)}
.bd.perfect{border-color:var(--gotedge);background:var(--got)}
.bd:not(.got):not(.perfect) .w{color:var(--offink)}
.tips{font-size:.9rem;line-height:1.6;margin:0;padding-left:1.1em}
.row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
.btn{font-family:var(--display);font-size:1.05rem;border-radius:8px;padding:8px 14px;cursor:pointer;border:2px solid var(--box-edge);background:var(--card);color:var(--box-ink)}
.btn.primary{background:var(--box-edge);color:#fff}
.btn.warn{border-color:var(--a);color:var(--a)}

/* cartridge select: sits over the game screen so the D-pad and A/B stay reachable */
.cartmenu{position:absolute;inset:0;background:rgba(16,19,30,.94);line-height:1.4;display:flex;flex-direction:column;gap:8px;padding:10px 12px;box-sizing:border-box;overflow:auto;z-index:3}
.cartmenu .ch{font-family:var(--display);font-size:1.3rem;letter-spacing:.04em;display:flex;justify-content:space-between;align-items:center}
.cartmenu .x{font-size:1rem;background:transparent;color:var(--muted);border:2px solid var(--edge);border-radius:999px;width:32px;height:32px;cursor:pointer}
.clist{display:flex;flex-direction:column;gap:8px}
.cart{display:flex;gap:12px;align-items:center;text-align:left;background:var(--shell-2);color:var(--ink);border:3px solid var(--edge);border-radius:10px;padding:8px 10px;cursor:pointer;font:inherit;min-width:0}
.cart.sel{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent)}
.cart .lab{flex:none;width:42px;height:50px;border-radius:5px 5px 2px 2px;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:1.1rem;color:#fff;box-shadow:inset 0 -8px 0 rgba(0,0,0,.25)}
.cart .info{min-width:0;flex:1}
.cart .t{font-family:var(--display);font-size:1.15rem;display:flex;gap:8px;align-items:baseline}
.cart .t small{font-family:var(--body);font-size:.75rem;color:var(--accent)}
.cart .d{font-size:.8rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cartmenu .hint{font-size:.8rem;color:var(--muted);text-align:center;margin-top:auto}
@media (max-width:360px){.dpad{grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px)}.ab button{width:58px;height:58px}.blist{grid-template-columns:repeat(2,1fr)}h1{font-size:1.25rem}}
@media (prefers-reduced-motion: reduce){.more{animation:none}}
</style>
</head><body>

<div class="wrap">
  <header>
    <h1>단어 마을</h1>
    <div class="hbtns">
      <button class="pill badge" id="badgeBtn">배지 0/0</button>
    </div>
  </header>

  <div class="quest" id="quest" hidden></div>

  <div class="screen" id="screen">
    <canvas id="cv" width="176" height="160"></canvas>
    <div class="dlg" id="dlg" hidden>
      <div class="who"><span id="who"></span><span class="tag" id="tag" hidden>복습</span></div>
      <div class="txt" id="txt"></div>
      <div class="choices" id="choices" hidden></div>
      <div class="more" id="more" hidden>▼</div>
    </div>
    <div class="toast" id="toast" hidden></div>
    <div class="gloss" id="gloss" hidden></div>
    <div class="cartmenu" id="cartPanel" hidden role="dialog" aria-label="카트리지 고르기">
      <div class="ch"><span id="cartTitle">카트리지</span> <button class="x" id="cartClose" aria-label="닫기">✕</button></div>
      <div id="cartList" class="clist"></div>
      <div class="hint">▲▼ 고르기 · A 시작 · B 닫기</div>
    </div>
  </div>

  <div class="pad">
    <div class="dpad" id="dpad">
      <button class="u" data-d="up" aria-label="위">▲</button>
      <button class="l" data-d="left" aria-label="왼쪽">◀</button>
      <span class="c"></span>
      <button class="r" data-d="right" aria-label="오른쪽">▶</button>
      <button class="d" data-d="down" aria-label="아래">▼</button>
    </div>
    <div class="ab">
      <button class="B" id="btnB" aria-label="B 닫기">B</button>
      <button class="A" id="btnA" aria-label="A 말하기">A</button>
    </div>
  </div>
  <div class="startrow"><button class="start" id="startBtn" aria-label="메뉴">START</button></div>
  <div class="help" id="help"></div>
</div>

<div class="panel" id="startPanel" hidden>
  <div class="sheet" role="dialog" aria-label="메뉴">
    <h2>메뉴 <button class="btn" id="startClose">닫기</button></h2>
    <div class="mgrid">
      <button class="mi" id="talkBtn">대화</button>
      <button class="mi" id="tapBtn">사전</button>
      <button class="mi wide cartmi" id="cartMi"><span class="cartbtn" id="cartBtn" aria-hidden="true"><span class="cl">1편</span></span>카트리지 바꾸기</button>
      <button class="mi toggle" id="sndBtn" aria-pressed="true">소리</button>
      <button class="mi" id="srcBtn" hidden>뉴스 출처</button>
      <button class="mi wide" id="linkBtn">이 편 링크 복사</button>
      <button class="mi wide" id="repBtn">문제 알리기</button>
    </div>
    <div class="games"><span>다른 게임</span><a href="https://stan-stani.github.io/seongsilho/" target="_blank" rel="noopener">성실호</a><a href="https://stan-stani.github.io/hyeongje/" target="_blank" rel="noopener">형제</a><a href="https://stan-stani.github.io/banghu/" target="_blank" rel="noopener">방과 후</a></div>
  </div>
</div>
<div class="panel" id="srcPanel" hidden>
  <div class="sheet" role="dialog" aria-label="뉴스 출처">
    <h2>뉴스 출처 <button class="btn" id="srcClose">닫기</button></h2>
    <ul class="srclist" id="srcList"></ul>
  </div>
</div>
<div class="panel" id="tapPanel" hidden>
  <div class="sheet talksheet" role="dialog" aria-label="찾아본 말">
    <h2><span>찾아본 말 <small id="tapCount"></small></span><button class="btn" id="tapClose">닫기</button></h2>
    <div class="tapsort"><button class="btn" id="tapSortT">최근</button><button class="btn" id="tapSortN">많이</button></div>
    <div class="talklog" id="tapList"></div>
  </div>
</div>
<div class="panel" id="talkPanel" hidden>
  <div class="sheet talksheet" role="dialog" aria-label="대화 기록">
    <h2>대화 기록 <button class="btn" id="talkClose">닫기</button></h2>
    <div class="talklog" id="talkList"></div>
  </div>
</div>
<div class="panel" id="panel" hidden>
  <div class="sheet">
    <h2>배지 <button class="qbtn" id="enToggle" aria-label="영어로 보기">?</button></h2>
    <p class="legend">★ 한 번에 다 맞혔어요 · ✓ 받았어요 (복습하면 ★) · ☆ 아직이에요</p>
    <div class="blist" id="blist"></div>
    <ul class="tips" id="tips"></ul>
    <div class="row">
