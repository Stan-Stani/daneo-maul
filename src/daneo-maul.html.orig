 {id:'nurse',name:'간호사',x:18,y:4,dir:'down',still:1,look:{hair:'#E07A9B',skin:'#F3D0B0',shirt:'#FFFFFF',pants:'#F4C2D0',long:1},badge:['상태','회복'],
