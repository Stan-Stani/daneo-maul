   {say:'멋져요! 꿈도 구현할 수 있어요.',award:['구현']}]},
 {id:'mod',name:'도윤',x:23,y:10,dir:'down',look:{hair:'#9A9AA3',skin:'#E6B892',shirt:'#B8B8B0',pants:'#5A5A60'},badge:['중립적'],
