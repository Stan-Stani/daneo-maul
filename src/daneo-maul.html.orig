<script>
/* =====================================================================
   카트리지 6편 · 복습 학교
   Content only — the engine draws, moves and runs dialogue. (Format notes: see 1편.)
   Review of words and slips from recent practice chats (이자, 엔, 받다/맞다, 나아야, 고쳐야,
   예를 들면, 첫 번째, 견디다/참다, 어울리다, 개선되다/개선하다, 저장하다, 어른/성인).
   Seven teachers each check a word or two; the principal hands over the 졸업장 once all are done.
   ===================================================================== */
(()=>{
const TEACH=['korean','nurse','shop','pc','art','pe','social'];
const done=()=>NPCS.filter(n=>TEACH.includes(n.id)&&n.badge.every(has)).length;

CARTRIDGES.push({
 id:'c6', n:'6편', title:'복습 학교', color:'#E9A23B', save:'daneo-maul-v6',
 words:[['처음이자','first and also'],['-엔','= 에는'],['받다','to receive, catch'],['낫다','to get better'],['고치다','to fix'],['개선되다','to get better (by itself)'],['저장하다','to save, store'],['첫 번째','the first'],['어울리다','to go well together'],['견디다','to endure'],['예를 들다','to give an example'],['어른','grown-up']],
 start:{x:12,y:9,dir:'down'},
 help:'사람 앞에서 <b>A</b>. 머리 위 <span class="k">!</span> 새 단어 · <span class="k">?</span> 복습해서 <span class="k">★</span> 받기',
 tips:['<b>처음이자</b> 마지막 기회 = 처음<b>이고</b> 마지막<b>인</b> 기회','다음<b>엔</b> = 다음<b>에는</b> · 주말<b>엔</b> = 주말<b>에는</b>','배지를 <b>받아요</b> · 정답이 <b>맞아요</b> · 공에 <b>맞아요</b>','낫다 → <b>나아요</b>, <b>나아야</b> 돼요 · 고치다 → <b>고쳐요</b>, <b>고쳐야</b> 돼요','내가 <b>개선해요</b> · 실력이 <b>개선돼요</b>','<b>예를 들면</b> (드르면 ✗) · <b>첫 번째</b> (1번째 ✗)','<b>참다</b>: 잠깐, 하고 싶은 걸 안 해요 · <b>견디다</b>: 오래, 힘든 걸 버텨요','<b>어른</b>: 말할 때 · <b>성인</b>: 서류, 법'],
 intro:['단어 마을 6편! 오늘은 복습 학교예요. 🏫','최근에 배운 단어를 다시 연습해요. 틀렸던 것도 있어요!','선생님 일곱 명을 만나 보세요. 다 만나면 교장 선생님한테 가요.'],
 done:['축하해요! 배지 열두 개를 다 모았어요! 🎉','처음이자, -엔, 받다, 낫다, 고치다, 개선되다, 저장하다, 첫 번째, 어울리다, 견디다, 예를 들다, 어른!','? 가 있는 선생님한테 다시 말해 보세요. 한 번에 맞히면 ★ 예요.'],
 perfect:['★ 열두 개! 모든 단어가 완벽해요!','한국어 실력이 많이 개선됐어요. 👏'],

 quest(){
  const n=done();
  if(n<TEACH.length)return {text:`🏫 선생님들을 만나요! ${n}/${TEACH.length}`};
  if(!state.graduated)return {late:true,text:'🎓 교장 선생님한테 가서 졸업장을 받아요!'};
  return null;
 },

 legend:{'.':{tile:'grass',walk:1},',':{tile:'path',walk:1},'*':{tile:'flowers',walk:1},'T':{tile:'tree'},
  'Z':{tile:'schoolWall'},'=':{tile:'wood',walk:1},'q':{tile:'floor',walk:1},'k':{tile:'board'},'e':{tile:'desk'},
