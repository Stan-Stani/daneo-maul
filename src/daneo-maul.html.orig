 easel:(X,Y,x,y)=>{grass(X,Y,x,y);r(X+4,Y+10,1,6,'#6B4A2B');r(X+11,Y+10,1,6,'#6B4A2B');r(X+7,Y+11,2,5,'#6B4A2B');r(X+2,Y+1,12,10,'#6B4A2B');r(X+3,Y+2,10,8,'#FFFFFF');r(X+4,Y+3,4,5,'#D9544B');r(X+8,Y+4,4,5,'#4F7BD6')},
 /* 7편 */
 bankWall:(X,Y,x,y)=>{const me=at(x,y);r(X,Y,16,16,'#C9CED8');r(X+2,Y,2,16,'#B3B9C6');r(X+12,Y,2,16,'#B3B9C6');if(at(x,y-1)!==me){r(X,Y,16,5,'#2E3548');r(X,Y+5,16,1,'#1B1E2B');if(x===19){r(X+5,Y+1,6,3,'#F2C94C');r(X+7,Y+2,2,1,'#2E3548')}}
   if(front(x,y)){if(x===17){r(X+3,Y+4,10,12,'#2E3548');r(X+4,Y+5,8,11,'#8CCBF5');r(X+8,Y+5,1,11,'#2E3548')}else if(x%2===0){r(X+4,Y+5,8,7,'#2E3548');r(X+5,Y+6,6,5,'#BFE3F5')}}},
 bigScreen:(X,Y,x,y,t)=>{const me=at(x,y);r(X,Y,16,16,'#1B1E2B');const top=at(x,y-1)!==me,bot=at(x,y+1)!==me;
   if(top)r(X,Y,16,2,'#3E4A63');if(bot){r(X,Y+13,16,3,'#3E4A63');if(x===5||x===6)r(X+6,Y+13,4,3,'#6B7390')}
   const f=Math.floor(t/600)%2;r(X+1,Y+(top?2:0),14,bot?13-(top?2:0):16-(top?2:0),f?'#3FA86B':'#2F8A57');
   if(x===4&&top){r(X+2,Y+3,12,12,'#FFFFFF');r(X+3,Y+4,10,10,'#1B1E2B');r(X+4,Y+5,8,8,'#4F7BD6');r(X+5,Y+6,6,6,'#D9544B');r(X+6,Y+7,4,4,'#F2C94C')}if(x===5&&top){r(X,Y+9,12,1,'#E8ECF2');r(X+11,Y+8,3,3,'#D9544B')}if(x===8&&top){r(X+3,Y+3,10,4,'#D9544B');r(X+4,Y+4,1,2,'#fff');r(X+6,Y+4,1,2,'#fff');r(X+8,Y+4,2,2,'#fff');r(X+11,Y+4,1,2,'#fff')}if(x===3&&!top){r(X+4,Y+2,1,8,'#F4F4F4');r(X+3,Y+5,8,1,'#F4F4F4')}if(x===7&&top){for(let i=0;i<3;i++)r(X+3+i*4,Y+9,2,2,'#FFFFFF')}},
 museumWall:(X,Y,x,y)=>{const me=at(x,y);r(X,Y,16,16,'#EDE3D0');r(X,Y+15,16,1,'#CDBF9F');if(at(x,y-1)!==me){r(X-1,Y,18,4,'#5A3A22');r(X,Y+4,16,2,'#8A5A33');r(X+2,Y+1,12,1,'#7A4E2E')}
   if(front(x,y)){r(X+2,Y+3,2,13,'#D8C9A8');r(X+12,Y+3,2,13,'#D8C9A8');if(x===19){r(X+5,Y+5,6,11,'#5A3A22')}else if(x%2===0){r(X+5,Y+6,6,6,'#5A3A22');r(X+6,Y+7,4,4,'#F7E7C8');r(X+7,Y+8,2,1,'#5A3A22');r(X+7,Y+9,1,2,'#5A3A22')}}},
 statue:(X,Y,x,y)=>{grass(X,Y,x,y);r(X+2,Y+12,12,4,'#9AA3B5');r(X+3,Y+11,10,1,'#B4BCCC');r(X+4,Y+4,8,7,'#7A6A3A');r(X+5,Y+5,6,5,'#9A8A4A');r(X+5,Y+0,6,5,'#7A6A3A');r(X+6,Y+1,4,3,'#B8A458');r(X+4,Y+0,8,1,'#5A4A2A');r(X+10,Y+6,3,2,'#E8ECF2')},
 mark:(X,Y,x,y)=>{wood(X,Y,x,y);for(let i=0;i<10;i++){r(X+3+i,Y+3+i,2,2,'#D9544B');r(X+12-i,Y+3+i,2,2,'#D9544B')}},
 domeDoor:(X,Y)=>{r(X,Y,16,16,'#D9DEE7');r(X+2,Y+3,12,13,'#3E4A63');r(X+7,Y+3,2,13,'#9AA3B5');r(X+2,Y+3,12,1,'#2A2F4A')},
 candyWall:(X,Y,x,y)=>{const me=at(x,y);r(X,Y,16,16,'#F6C3D0');r(X,Y+15,16,1,'#D99AAD');if(at(x,y-1)!==me){r(X,Y,16,4,'#8A4B5E');r(X,Y+4,16,1,'#6E3A4A')}
   if(front(x,y)){for(let i=0;i<4;i++)r(X+i*4,Y,4,5,i%2?'#FFFFFF':'#E07A9B');r(X,Y+5,16,1,'#B85A78');
     if(x===4){r(X+4,Y+7,8,9,'#6B4A2B');r(X+10,Y+11,1,1,'#F2C94C')}else{r(X+3,Y+7,10,6,'#6B4A2B');r(X+4,Y+8,8,4,'#FFF3E8');r(X+5,Y+10,2,2,'#6B3A22');r(X+9,Y+10,2,2,'#6B3A22')}}},
 chickenWall:(X,Y,x,y)=>{const me=at(x,y);r(X,Y,16,16,'#F7F3EE');r(X,Y+15,16,1,'#D8D0C4');if(at(x,y-1)!==me){r(X,Y,16,5,'#C8332C');r(X,Y+5,16,1,'#8E231E')}
   if(front(x,y)){r(X,Y,16,4,'#C8332C');r(X,Y+4,16,1,'#8E231E');
     if(x===12){r(X+3,Y+6,10,10,'#5A3A22');r(X+4,Y+7,8,9,'#BFE3F5');r(X+8,Y+7,1,9,'#5A3A22')}else{r(X+3,Y+6,10,7,'#5A3A22');r(X+4,Y+7,8,5,'#FFF6D8')}}
   else if(y===13&&x===11){r(X+4,Y+3,8,9,'#C8332C');r(X+6,Y+5,4,5,'#FFFFFF')}},
 /* 8편 */
 appleTree:(X,Y,x,y)=>{grass(X,Y,x,y);r(X+6,Y+11,4,5,'#6B4A2B');r(X+2,Y+1,12,11,'#3E8E3A');r(X+1,Y+3,14,7,'#3E8E3A');r(X+4,Y+2,5,3,'#5CB85A');r(X+2,Y+10,12,1,'#2E7A3A');
   [[3,4],[9,3],[6,7],[11,7],[4,9]].forEach(([a,b],i)=>{if((hash(x,y)+i)%4)return;r(X+a,Y+b,2,2,'#D9544B');r(X+a,Y+b,1,1,'#F28C7A')});r(X+9,Y+3,2,2,'#D9544B');r(X+4,Y+8,2,2,'#D9544B')},
 fallen:(X,Y,x,y)=>{grass(X,Y,x,y);const h=hash(x,y);[[3+h%4,9],[9,4+h%5],[11-h%3,12]].forEach(([a,b])=>{r(X+a,Y+b,3,3,'#D9544B');r(X+a,Y+b,1,1,'#F28C7A');r(X+a+1,Y+b-1,1,1,'#6B4A2B')})},
 tent:(X,Y,x,y)=>{const me=at(x,y);const top=at(x,y-1)!==me;
   if(top){grass(X,Y,x,y);for(let i=0;i<4;i++)r(X+i*4,Y+4,4,12,(x*4+i)%2?'#FFFFFF':'#D97B2B');r(X,Y+4,16,1,'#A85A1E');if(x%2===0){r(X+7,Y,1,5,'#6B4A2B');r(X+8,Y,4,3,'#F2C94C')}}
   else{r(X,Y,16,16,'#F7E7C8');for(let i=0;i<4;i++)r(X+i*4,Y,4,4,(x*4+i)%2?'#FFFFFF':'#D97B2B');r(X,Y+4,16,1,'#A85A1E');r(X,Y+9,16,7,'#9A6A3C');r(X,Y+9,16,2,'#B68350');
     if(x%2){r(X+3,Y+6,4,3,'#F2C94C');r(X+9,Y+6,4,3,'#D9544B')}else{r(X+5,Y+5,6,4,'#E8B98F');r(X+6,Y+6,4,1,'#C98D78')}}},
 speaker:(X,Y,x,y)=>{wood(X,Y,x,y);r(X+3,Y+1,10,14,'#1B1E2B');r(X+4,Y+2,8,12,'#2A2F4A');r(X+6,Y+3,4,3,'#6B7390');r(X+5,Y+8,6,5,'#6B7390');r(X+7,Y+9,2,3,'#1B1E2B')},
 target:(X,Y,x,y)=>{sand(X,Y,x,y);r(X+3,Y+12,2,4,'#6B4A2B');r(X+11,Y+12,2,4,'#6B4A2B');r(X+2,Y+1,12,12,'#1B1E2B');r(X+3,Y+2,10,10,'#F4F4F4');r(X+4,Y+3,8,8,'#4F7BD6');r(X+5,Y+4,6,6,'#D9544B');r(X+6,Y+5,4,4,'#F2C94C');r(X+7,Y+6,2,2,'#E0A82E')},
};
function tile(x,y,X,Y,t){const L=C.legend[at(x,y)];const f=L&&TILES[L.tile];if(f)f(X,Y,x,y,t);else r(X,Y,16,16,'#000')}

function drawChar(c,X,Y,dir,step){
  const L=c.look,ol='#1B1E2B';
  g.fillStyle='rgba(0,0,0,.22)';g.fillRect(X+3,Y+14,10,2);
  const lg=step?1:0;
  r(X+5,Y+11,6,4,ol);r(X+6,Y+11,2,3+(step===1?0:lg),L.pants);r(X+9,Y+11,2,3+(step===2?0:lg),L.pants);
  r(X+3,Y+7,10,6,ol);
  if(L.shirt==='stripe'){r(X+4,Y+8,8,4,'#F4F4F4');for(let i=0;i<4;i++)r(X+4+i*2,Y+8,1,4,'#1F1F1F')}else r(X+4,Y+8,8,4,L.shirt);
  if(L.belt)r(X+4,Y+11,8,1,L.belt);
  r(X+3,Y+1,10,8,ol);r(X+4,Y+2,8,6,L.skin);
  const hair=L.hair;
  if(dir==='up'){r(X+4,Y+2,8,6,hair)}
  else{
    r(X+4,Y+1,8,3,hair);
    if(dir==='left'){r(X+10,Y+2,2,4,hair);r(X+5,Y+5,1,1,ol)}
    else if(dir==='right'){r(X+4,Y+2,2,4,hair);r(X+10,Y+5,1,1,ol)}
    else{r(X+6,Y+5,1,1,ol);r(X+9,Y+5,1,1,ol);r(X+7,Y+7,2,1,'#C98D78')}
    if(L.long){r(X+3,Y+3,1,6,hair);r(X+12,Y+3,1,6,hair)}
  }
  if(L.cap){r(X+3,Y+0,10,3,ol);r(X+4,Y+1,8,2,L.cap);if(dir==='down')r(X+4,Y+3,8,1,'#A83A33');if(dir==='left')r(X+2,Y+3,4,1,'#A83A33');if(dir==='right')r(X+10,Y+3,4,1,'#A83A33')}
}

function drawDog(L,X,Y,dir,step,hurt){
  const ol='#1B1E2B';
  g.fillStyle='rgba(0,0,0,.22)';g.fillRect(X+3,Y+14,10,2);
  const s=step?1:0;
  if(dir==='left'||dir==='right'){
    const R=(x,y,w,h,c)=>r(dir==='left'?X+x:X+16-x-w,Y+y,w,h,c);
    R(4,8,10,5,ol);R(5,9,8,3,L.fur);
    R(5,12,2,3-s,ol);R(11,12,2,2+s,ol);
    R(13,5,2,4,ol);R(13,6,1,2,L.fur);
    R(1,4,7,6,ol);R(2,5,5,4,L.fur);
    R(0,7,2,2,ol);R(3,6,1,1,ol);
    R(5,3,3,4,L.ear);
  }else{
    r(X+4,Y+8,8,5,ol);r(X+5,Y+9,6,3,L.fur);
    r(X+5,Y+12,2,step===1?2:3,ol);r(X+9,Y+12,2,step===2?2:3,ol);
    r(X+4,Y+2,8,7,ol);r(X+5,Y+3,6,5,L.fur);
    r(X+3,Y+2,2,5,L.ear);r(X+11,Y+2,2,5,L.ear);
    if(dir==='down'){r(X+6,Y+5,1,1,ol);r(X+9,Y+5,1,1,ol);r(X+7,Y+6,2,1,ol)}
    else{r(X+5,Y+3,6,2,L.ear);r(X+7,Y+11,2,3,ol)}
  }
  if(hurt){const y=Y-4+Math.round(Math.sin(performance.now()/200));r(X+10,y,5,5,'#1B1E2B');r(X+11,y+1,3,3,'#8E7CC3');r(X+12,y+2,1,1,'#E6DCFF')}
}
/* follower: walks one tile behind the player (cartridge.follower) */
const pet={x:0,y:0,fx:0,fy:0,dir:'down',on:false};
const petOn=()=>!!(C&&C.follower&&C.follower.when());
function petReset(){pet.x=pet.fx=player.x;pet.y=pet.fy=player.y;pet.dir=player.dir}

function marker(X,Y,t,st){
  if(!st)return;
  const bob=Math.round(Math.sin(t/220)*1.5);
  if(st==='todo'){r(X+6,Y-9+bob,4,8,'#1B1E2B');r(X+7,Y-8+bob,2,4,'#F2C94C');r(X+7,Y-3+bob,2,1,'#F2C94C')}
  else if(st==='review'){const y=Y-10+bob;r(X+5,y,6,9,'#1B1E2B');r(X+6,y+1,4,7,'#4F7BD6');r(X+7,y+2,2,1,'#fff');r(X+8,y+3,1,1,'#fff');r(X+7,y+4,1,1,'#fff');r(X+7,y+6,1,1,'#fff')}
  else if(st==='wait'){const y=Y-5+bob;[5,7,9].forEach((dx,i)=>r(X+dx,y,1,1,Math.floor(t/300)%3===i?'#FFFFFF':'#A5AEC4'))}
  else{const y=Y-9+bob;r(X+7,y,2,2,'#F2C94C');r(X+4,y+2,8,2,'#F2C94C');r(X+5,y+4,6,1,'#F2C94C');r(X+5,y+5,2,2,'#F2C94C');r(X+9,y+5,2,2,'#F2C94C');r(X+7,y+2,2,2,'#FFF3B0')}
}
function status(n){
  if(!n.badge)return null;
  if(n.status){const v=n.status();if(v!==undefined)return v}
  if(!n.badge.every(has))return 'todo';
  return n.badge.every(b=>state.perfect.includes(b))?'perfect':'review';
}

/* ---------- movement ---------- */
const D={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
const OPP={up:'down',down:'up',left:'right',right:'left'};
const player={x:0,y:0,dir:'down',moving:false,t:0,fx:0,fy:0,step:0,look:{hair:'#2A2F4A',skin:'#F1C9A5',shirt:'#D9544B',pants:'#2E3548',cap:'#D9544B'}};
let held=null;
const npcAt=(x,y)=>NPCS.find(n=>n.x===x&&n.y===y);
const walkable=(x,y)=>!!(C.legend[at(x,y)]||{}).walk;
const blocked=(x,y)=>!walkable(x,y)||!!npcAt(x,y);
const menuOpen=()=>!$('cartPanel').hidden;
const panelOpen=()=>!$('startPanel').hidden||!$('srcPanel').hidden||!$('panel').hidden||menuOpen()||!$('talkPanel').hidden||!$('tapPanel').hidden||(!!$('repPanel')&&!$('repPanel').hidden);

function tryMove(){
  if(player.moving||!held||dlg||panelOpen())return;
  player.dir=held;const [dx,dy]=D[held];const nx=player.x+dx,ny=player.y+dy;
  if(blocked(nx,ny))return;
  player.moving=true;player.t=0;player.fx=player.x;player.fy=player.y;player.x=nx;player.y=ny;player.step=player.step===1?2:1;
  if(petOn()){const ox=player.fx,oy=player.fy;pet.fx=pet.x;pet.fy=pet.y;if(ox!==pet.x||oy!==pet.y)pet.dir=ox>pet.x?'right':ox<pet.x?'left':oy>pet.y?'down':'up';pet.x=ox;pet.y=oy}
}
function update(dt,now){
  if(player.moving){player.t+=dt/170;if(player.t>=1){player.t=0;player.moving=false;state.x=player.x;state.y=player.y;state.dir=player.dir;if(C.onStep){C.onStep();updateQuest()}save();tryMove()}}
  else tryMove();
  if(!dlg)NPCS.forEach(n=>{if(n.still)return;if(now>n.turnAt){const ds=['down','left','right',n.home,n.home];n.dir=ds[Math.random()*ds.length|0];n.turnAt=now+2500+Math.random()*3500}});
}
function render(now){
  const px=player.moving?player.fx+(player.x-player.fx)*player.t:player.x;
  const py=player.moving?player.fy+(player.y-player.fy)*player.t:player.y;
  let cx=px*TS+8-VW*TS/2,cy=py*TS+8-VH*TS/2;
  cx=Math.max(0,Math.min(cx,MW*TS-VW*TS));cy=Math.max(0,Math.min(cy,MH*TS-VH*TS));
  cx=Math.round(cx);cy=Math.round(cy);
  const x0=Math.floor(cx/TS),y0=Math.floor(cy/TS);
  for(let y=y0;y<=y0+VH;y++)for(let x=x0;x<=x0+VW;x++)tile(x,y,x*TS-cx,y*TS-cy,now);
  const ents=NPCS.map(n=>({y:n.y,f:()=>{const X=n.x*TS-cx,Y=n.y*TS-cy-2;(n.kind==='dog'?drawDog(n.look,X,Y,n.dir,0):drawChar(n,X,Y,n.dir,0));marker(X,Y,now,status(n))}}));
  const walk=player.moving?(player.t<.5?player.step:0):0;
  if(petOn()){
    if(!pet.on){petReset();pet.on=true}
    const qx=player.moving?pet.fx+(pet.x-pet.fx)*player.t:pet.x,qy=player.moving?pet.fy+(pet.y-pet.fy)*player.t:pet.y;
    ents.push({y:qy-.01,f:()=>drawDog(C.follower.look,Math.round(qx*TS-cx),Math.round(qy*TS-cy-1),pet.dir,walk?3-walk:0,C.follower.hurt&&C.follower.hurt())});
  }else pet.on=false;
  ents.push({y:py,f:()=>drawChar(player,Math.round(px*TS-cx),Math.round(py*TS-cy-2),player.dir,walk)});
  ents.sort((a,b)=>a.y-b.y).forEach(e=>e.f());
}
let last=performance.now();
function loop(now){const dt=Math.min(50,now-last);last=now;if(C){update(dt,now);render(now)}requestAnimationFrame(loop)}

/* ---------- dialogue ---------- */
let dlg=null,typing=null,pendingCelebrate=null,sel=0,gen=0; // gen: bumped on reset/boot so late timers from the old run do nothing
function openDialog(name,steps,opts={}){
  dlg={name,steps:steps.map(s=>({...s})),i:0,cur:null,next:null,miss:0,npc:opts.npc||null};
  $('tag').hidden=!opts.review;
  $('dlg').hidden=false;show(dlg.steps[0]);
}
function show(s){
  hideGloss();
  dlg.cur=s;
  if(s.set){s.set();save();updateQuest()}
  if(s.award)award(s.award);
  $('who').textContent=s.who||dlg.name;$('choices').hidden=true;$('choices').innerHTML='';$('more').hidden=true;
  logTalk(s.who||dlg.name,s.say||s.ask);
  lastLines.push(((s.who||dlg.name||'')+': '+String(s.say||s.ask||'').replace(/<[^>]*>/g,'')).slice(0,300));if(lastLines.length>3)lastLines.shift();
  typeText(s.say||s.ask,()=>{if(s.ask)renderChoices(s);else $('more').hidden=false});
}
/* ---------- tap a word: Korean definition, English only behind ? (dictionary in window.LEX, built by build.py) ---------- */
function wordsHTML(t){const esc=x=>x.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));return esc(t).replace(/[가-힣]+/g,w=>`<span class="w">${w}</span>`)}
function lexLookup(w){ // word as written → [[lemma,{k,e}],…]; unknown words fall back to the longest known prefix (상대가 → 상대)
  const L=window.LEX||{map:{},defs:{}},hit=l=>L.defs[l]?[l,L.defs[l]]:null;
  let ls=L.map[w];
  if(!ls)for(let n=w.length;n>0&&!ls;n--){const pre=w.slice(0,n); // longest known prefix, also as a verb/adjective stem (강해서 → 강하다)
  const tries=[pre,pre+'다',/[해했]$/.test(pre)?pre.slice(0,-1)+'하다':null].filter(Boolean);
  if(L.map[pre])ls=L.map[pre];else{const t=tries.find(x=>hit(x));if(t)ls=[t]}}
  return (ls||[]).map(hit).filter(Boolean);
}
function hideGloss(){$('gloss').hidden=true}
/* ---------- conversation log: every line shown, scrollable, words tappable like in the dialogue box ---------- */
let talk=[];
function loadTalk(){talk=[];try{talk=JSON.parse(localStorage.getItem(C.save+'-talk')||'[]')}catch(e){}}
function logTalk(who,text){
  if(!text)return;const last=talk[talk.length-1];if(last&&last[0]===who&&last[1]===text)return;
  talk.push([who,text]);if(talk.length>150)talk=talk.slice(-150);
  try{localStorage.setItem(C.save+'-talk',JSON.stringify(talk))}catch(e){}
}
function openTalk(){
  const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  $('talkList').innerHTML=talk.length?talk.map(([w,t])=>`<div class="tl"><span class="tw">${esc(w)}</span><span class="tt txt">${wordsHTML(t)}</span></div>`).join(''):'<p class="tl-empty">아직 대화가 없어요.</p>';
  $('talkPanel').hidden=false;document.body.classList.add('talkopen');const L=$('talkList');L.scrollTop=L.scrollHeight;
}
function closeTalk(){$('talkPanel').hidden=true;document.body.classList.remove('talkopen');hideGloss()}
/* Until the player has tapped a word once, the longest word with a definition pulses with a small "눌러 보세요" tag. */
function tapHint(el){
  if(explained.tapWord)return;
  const w=[...el.querySelectorAll('.w')].filter(x=>lexLookup(x.textContent).length).sort((a,b)=>b.textContent.length-a.textContent.length)[0];
  if(!w)return;w.classList.add('hint');w.insertAdjacentHTML('afterend','<span class="taptip">눌러 보세요</span>');
}
/* 찾아본 말: every tap that finds a definition — how many times, and when last (all cartridges, one list) */
let taps={},tapSort='t';try{taps=JSON.parse(localStorage.getItem('daneo-maul-taps')||'{}')||{}}catch(e){taps={}}
function noteTap(rows){const [h,d]=rows[0]||[];if(!h)return;const r=taps[h]||(taps[h]={n:0,t:0});r.n++;r.t=Date.now();r.k=d.k;r.e=d.e;try{localStorage.setItem('daneo-maul-taps',JSON.stringify(taps))}catch(e){}}
function ago(t){const m=Math.floor((Date.now()-t)/60000);if(m<1)return '방금';if(m<60)return m+'분 전';const h=Math.floor(m/60);if(h<24)return h+'시간 전';const d=Math.floor(h/24);return d===1?'어제':d+'일 전'}
function openTaps(){
  const esc=x=>String(x||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const rows=Object.entries(taps).sort((a,b)=>tapSort==='n'?(b[1].n-a[1].n||b[1].t-a[1].t):b[1].t-a[1].t);
  $('tapCount').textContent=rows.length?rows.length+'개':'';
  $('tapList').innerHTML=rows.length?rows.map(([h,r])=>`<div class="tp"><div class="tph"><b>${esc(h)}</b><span class="tpm">${r.n}번 · ${ago(r.t)}</span></div><div class="tpk">${esc(r.k)}</div><div class="tpe" hidden>${esc(r.e)}</div></div>`).join('')
    :'<p class="tl-empty">아직 찾아본 말이 없어요.</p>';
  if(!$('tapCopy')){const c=document.createElement('button');c.className='btn';c.id='tapCopy';c.textContent='복사';c.style.marginLeft='auto';c.addEventListener('click',()=>copyTaps($('tapList')));$('tapSortN').after(c)}
  $('tapCopy').hidden=!rows.length;if($('tapText'))$('tapText').hidden=true;
  $('tapSortT').classList.toggle('on',tapSort==='t');$('tapSortN').classList.toggle('on',tapSort==='n');
  $('tapPanel').hidden=false;document.body.classList.add('talkopen');$('tapList').scrollTop=0;
}
function closeTaps(){$('tapPanel').hidden=true;document.body.classList.remove('talkopen')}
/* 복사: every looked-up word as plain text (word | times | last day | meaning | English), to paste into a chat and practise */
function tapsText(){
  const d=t=>{const x=new Date(t);return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0')};
  const rows=Object.entries(taps).sort((a,b)=>tapSort==='n'?(b[1].n-a[1].n||b[1].t-a[1].t):b[1].t-a[1].t);
  return `단어 마을 · 찾아본 말 ${rows.length}개 (${d(Date.now())})\n단어 | 찾은 횟수 | 마지막으로 찾은 날 | 뜻 | English\n`
    +rows.map(([h,r])=>[h,r.n,d(r.t),r.k||'',r.e||''].map(x=>String(x).replace(/\s*\|\s*/g,' / ')).join(' | ')).join('\n')+'\n';
}
function copyTaps(before){
  const txt=tapsText();
  const show=()=>{  // no clipboard (some embeds block it): show the text selected, ready for the phone's own copy
    let ta=document.getElementById('tapText');if(!ta){ta=document.createElement('textarea');ta.id='tapText';ta.readOnly=true;ta.style.cssText='width:100%;height:9em;font-size:.8rem;margin:6px 0;box-sizing:border-box';before.before(ta)}
    ta.hidden=false;ta.value=txt;ta.focus();ta.select();let ok=false;try{ok=document.execCommand('copy')}catch(e){}if(ok)toast('복사했어요!')};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(txt).then(()=>toast('복사했어요!'),show);else show();
}

function showWord(w){
  if(firstTime('tapWord'))document.querySelectorAll('.taptip').forEach(x=>x.remove()),document.querySelectorAll('.w.hint').forEach(x=>x.classList.remove('hint'));
  const rows=lexLookup(w);if(!rows.length){hideGloss();toast('사전에 없는 말이에요.');return}
  noteTap(rows);lastWord=(w+' → '+rows.map(([h,d])=>h+': '+d.k).join(' / ')).slice(0,400);
  const el=$('gloss');
  el.innerHTML=rows.map(([h,d])=>`<div><b>${h}</b>${d.k}<span class="en" hidden>${d.e||''}</span></div>`).join('')+'<button class="q" type="button" aria-label="영어로 보기">?</button><button class="gx" type="button" aria-label="닫기">×</button>';
  el.classList.remove('pinned');el.hidden=false;
  if(!explained.tapEnglish)el.querySelector('.q').classList.add('pulse'); // until the player has tried ? once
  el.querySelector('.q').addEventListener('click',e=>{e.stopPropagation();if(firstTime('tapEnglish'))e.currentTarget.classList.remove('pulse');el.querySelectorAll('.en').forEach(x=>x.hidden=!x.hidden);if(!el.classList.contains('pinned')){clearTimeout(showWord.t);showWord.t=setTimeout(hideGloss,8000)}});
  clearTimeout(showWord.t);showWord.t=setTimeout(hideGloss,6000);
}
function typeText(text,done){
  clearInterval(typing?.id);const el=$('txt');el.textContent='';let i=0;
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  typing={text,done,id:null,finished:false};
  const fin=()=>{clearInterval(typing.id);el.innerHTML=wordsHTML(text);tapHint(el);typing.finished=true;done()};
  typing.fin=fin;
  if(reduce)return fin();
  const seg=(()=>{try{return [...new Intl.Segmenter('ko',{granularity:'grapheme'}).segment(text)].map(x=>x.segment)}catch(e){return Array.from(text)}})();  // whole characters: never half an emoji (it shows as ? for a tick)
  typing.id=setInterval(()=>{i++;el.textContent=seg.slice(0,i).join('');if(i>=seg.length)fin()},28);
}
const choiceBtns=()=>[...document.querySelectorAll('#choices .choice')];
const choosing=()=>!!dlg&&!$('choices').hidden&&choiceBtns().length>0;
function renderChoices(s){
  const box=$('choices');box.hidden=false;
  const order=s.opts.map((_,i)=>i);
  for(let i=order.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[order[i],order[j]]=[order[j],order[i]]}
  box.innerHTML=order.map(i=>`<button class="choice" data-i="${i}">${String(s.opts[i][0]).replace(/[가-힣]+/g,w=>`<span class="cw">${w}</span>`)}</button>`).join('');
  let pressT=null,defined=false;  // long-press a word on a choice = its definition (doesn't answer)
  box.querySelectorAll('.choice').forEach(b=>{
    b.addEventListener('pointerdown',e=>{const w=e.target.closest('.cw');defined=false;clearTimeout(pressT);if(w)pressT=setTimeout(()=>{defined=true;showWord(w.textContent)},450)});
    for(const t of ['pointerup','pointerleave','pointercancel'])b.addEventListener(t,()=>clearTimeout(pressT));
    b.addEventListener('click',e=>{e.stopPropagation();if(defined){defined=false;return}choose(s,+b.dataset.i)})});
  sel=-1;choicesAt=performance.now();markSel();  // nothing selected: A can't answer by accident
}
function markSel(){const bs=choiceBtns();bs.forEach((b,i)=>b.classList.toggle('sel',i===sel));bs[sel]?.focus({preventScroll:true});bs[sel]?.scrollIntoView({block:'nearest'})}
function moveSel(d){if(performance.now()-choicesAt<450)return;const n=choiceBtns().length;if(!n)return;sel=sel<0?(d>0?0:n-1):(sel+d+n)%n;markSel();sfx('move')}
let choicesAt=0;
function confirmSel(){if(sel<0||performance.now()-choicesAt<450)return;const b=choiceBtns()[sel];if(b)b.click()}
function choose(s,i){
  const o=s.opts[i];
  if(o[1]){
    sfx('ok');
    if(s.review){
      const all=(s.w?[s.w]:dlg.npc.badge);
      const ws=all.filter(w=>!state.perfect.includes(w));
      let msg;
      if(s.missed){if(ws.length){if(firstTime('reviewMiss'))msg=`아쉬워요! ★는 한 번에 맞혀야 돼요. 다음에 다시 와요. (${ws.join(', ')})`;else setTimeout(()=>toast('다음에 다시!'),250)}}
      else if(ws.length){state.perfect.push(...ws);save();updateHud();setTimeout(()=>{toast('★ 완벽: '+ws.join(', ')+'!');sfx('star')},250);checkPerfectAll();
        if(firstTime('reviewStar')){msg=`★ 한 번에 맞혔어요! "${ws.join('", "')}" 배지가 별이 됐어요.`;
        const n=dlg.npc; if(n&&n.badge.some(b=>!state.perfect.includes(b))) msg+=' 이 사람한테 다른 단어도 있어요. 다시 말해 보세요!';}}
      if(msg)dlg.steps.splice(dlg.i+1,0,{say:msg});
    }
    dlg.next='advance';show({who:s.who,say:'맞아요! '+(s.ask.includes('___')?s.ask.replace('___',o[0]):o[0])});
  }else{
    sfx('no');dlg.miss++;s.missed=true;
    dlg.next=s;show({who:s.who,say:o[2]});
  }
}
function advance(){
  if(!dlg)return;
  if(typing&&!typing.finished){typing.fin();return}
  if(dlg.cur.ask)return;
  if(dlg.next){const n=dlg.next;dlg.next=null;if(n!=='advance'){show(n);return}}
  dlg.i++;
  if(dlg.i>=dlg.steps.length){closeDialog();return}
  show(dlg.steps[dlg.i]);
}
let offerNext=false;
function closeDialog(){
  dlg=null;clearInterval(typing?.id);$('dlg').hidden=true;
  maybeComplete();
  if(pendingCelebrate){const c=pendingCelebrate,g=gen;pendingCelebrate=null;setTimeout(()=>{if(!dlg&&g===gen)openDialog('단어 마을',c)},500);return}
  if(offerNext){offerNext=false;const i=CARTRIDGES.indexOf(C);const g=gen;if(i<CARTRIDGES.length-1)setTimeout(()=>{if(!dlg&&g===gen)openMenu(i+1)},600)}
}
function cancel(){
  if(!$('gloss').hidden){hideGloss();return}
  if(!$('startPanel').hidden){$('startPanel').hidden=true;return}
  if($('repPanel')&&!$('repPanel').hidden){closeReport();return}
  if(!$('srcPanel').hidden){$('srcPanel').hidden=true;return}
  if(!$('tapPanel').hidden){closeTaps();return}
  if(!$('talkPanel').hidden){closeTalk();return}
  if(menuOpen())closeMenu();
  else if(dlg)closeDialog();
  else if(!$('panel').hidden)$('panel').hidden=true;
}
const says=a=>(Array.isArray(a)?a:[a]).map(t=>({say:t}));

function review(n){
  const pool=(n.pool||n.talk.filter(s=>s.ask));
  const weak=pool.filter(q=>!(q.w?[q.w]:n.badge).every(w=>state.perfect.includes(w)));
  const from=weak.length?weak:pool;
  const q=from[Math.random()*from.length|0];
  return [...says(n.after),{...q,review:true}];
}
function interact(){
  if(!$('gloss').hidden){hideGloss();return}  // A closes the definition first, without advancing
  if(menuOpen()){pickCart(menuSel);return}
  if(!$('panel').hidden)return;
  if(choosing()){confirmSel();return}
  if(dlg){advance();return}
  if(player.moving)return;
  const [dx,dy]=D[player.dir];const tx=player.x+dx,ty=player.y+dy;
  let n=npcAt(tx,ty);
  if(!n&&(C.legend[at(tx,ty)]||{}).over)n=npcAt(tx+dx,ty+dy); // talk across a counter
  if(n){
    if(!n.still){n.dir=OPP[player.dir];n.turnAt=performance.now()+6000}
    let steps=n.script?n.script():null,isReview=false;
    if(!steps){
      if(n.badge&&n.badge.every(has)){steps=review(n);isReview=true}
      else steps=n.talk;
    }
    openDialog(n.name,steps,{npc:n,review:isReview});
    return;
  }
  if(petOn()&&pet.x===tx&&pet.y===ty&&!(pet.x===player.x&&pet.y===player.y)&&C.follower.talk){openDialog(C.follower.name,C.follower.talk());return}
  const key=tx+','+ty;
  if(C.signs&&C.signs[key]){openDialog(C.signs[key][0],says(C.signs[key][1]));return}
  if(C.spots&&C.spots[key]){openDialog('…',says(C.spots[key]));return}
  const th=C.things&&C.things[at(tx,ty)];
  if(th){openDialog('…',typeof th==='function'?th(tx,ty):th);return}
}

/* Each rule is explained once per player (all cartridges), then only the toast shows. */
let explained={};try{explained=JSON.parse(localStorage.getItem('daneo-maul-explained')||'{}')}catch(e){}
function firstTime(k){if(explained[k])return false;explained[k]=1;try{localStorage.setItem('daneo-maul-explained',JSON.stringify(explained))}catch(e){}return true}
function award(words){
  const nw=words.filter(w=>!has(w));if(!nw.length)return;
  state.badges.push(...nw);
  const perfect=dlg&&dlg.miss===0;
  if(perfect)nw.forEach(w=>{if(!state.perfect.includes(w))state.perfect.push(w)});
  save();updateHud();updateQuest();
  toast('배지 획득: '+nw.join(', ')+(perfect?' ★':' ✓'));sfx('badge');
  if(dlg&&firstTime(perfect?'star':'check')){
    const note=perfect?{who:'단어 마을',say:`★ 한 번도 안 틀렸어요! "${nw.join('", "')}" 배지는 별이에요.`}
                      :{who:'단어 마을',say:`✓ 배지를 받았어요. 틀린 문제가 있어서 아직 별은 아니에요. 머리 위에 ? 가 생겼어요. 다시 말하면 복습 문제가 나와요!`};
    dlg.steps.splice(dlg.i+1,0,note);
  }
  maybeComplete();
  checkPerfectAll();
}
// A cartridge is finished when every badge is collected AND its story is done (no objective left, e.g. 6편's 졸업장):
// only then the celebration and the offer of the next cartridge.
function maybeComplete(){
  if(state.badges.length>=C.words.length&&!state.celebrated&&!(C.quest&&C.quest())){
    state.celebrated=true;save();
    pendingCelebrate=(pendingCelebrate||[]).concat(says(C.done));offerNext=true;
  }
}
function checkPerfectAll(){
  if(state.perfect.length>=C.words.length&&!state.celebratedPerfect){
    state.celebratedPerfect=true;save();
    pendingCelebrate=(pendingCelebrate||[]).concat(says(C.perfect));
  }
}
let toastT;function toast(t){const el=$('toast');el.textContent=t;el.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>el.hidden=true,2400)}

/* ---------- HUD ---------- */
function updateHud(){$('badgeBtn').textContent=`배지 ${state.badges.length}/${C.words.length} · ★${state.perfect.length}`}
function updateQuest(){
  const q=$('quest');const v=C.quest?C.quest():null;
  q.hidden=!v;q.textContent=v?v.text:'';q.classList.toggle('late',!!(v&&v.late));
}
function updateSound(){$('sndBtn').setAttribute('aria-pressed',soundOn?'true':'false');}
function openPanel(){
  $('blist').innerHTML=C.words.map(([w,m])=>{const got=has(w),pf=state.perfect.includes(w);return `<div class="bd ${pf?'perfect':got?'got':''}"><span class="s">${pf?'★':got?'✓':'☆'}</span><span class="w">${w}</span><span class="m">${m}</span></div>`}).join('');
  $('tips').innerHTML=(C.tips||[]).map(t=>`<li>${t}</li>`).join('');
  $('panel').hidden=false;$('closePanel').focus();
}

/* ---------- saving ---------- */
function fresh(){return {badges:[],perfect:[],seenIntro:false,x:C.start.x,y:C.start.y,dir:C.start.dir,celebrated:false,celebratedPerfect:false,...JSON.parse(JSON.stringify(C.fresh||{}))}}
function save(){try{localStorage.setItem(C.save,JSON.stringify(state))}catch(e){}}
function loadState(){
  state=fresh();
  try{const s=JSON.parse(localStorage.getItem(C.save)||'null');if(s)Object.assign(state,s)}catch(e){}
  if(!Array.isArray(state.perfect))state.perfect=[];
  if(!walkable(state.x,state.y)||npcAt(state.x,state.y)){state.x=C.start.x;state.y=C.start.y}
}

/* ---------- cartridges ---------- */
function boot(id){
  const next=CARTRIDGES.find(c=>c.id===id)||CARTRIDGES[0];
  if(dlg){dlg=null;clearInterval(typing?.id);$('dlg').hidden=true}
  gen++;offerNext=false;pendingCelebrate=null;held=null;$('panel').hidden=true;$('toast').hidden=true;
  C=next;
  MAP=C.map.map(r=>r.split(''));MW=MAP[0].length;MH=MAP.length;
  NPCS=C.npcs;NPCS.forEach(n=>{n.home=n.home||n.dir;n.turnAt=performance.now()+2000+Math.random()*3000});
  loadState();loadTalk();
  Object.assign(player,{x:state.x,y:state.y,dir:state.dir,moving:false,t:0});petReset();pet.on=false;
  $('cartBtn').innerHTML=`<span class="cl">${C.n}</span>`;$('cartBtn').style.setProperty('--cart',C.color);$('srcBtn').hidden=!C.sources;$('help').innerHTML=C.help||'';
  try{localStorage.setItem('daneo-maul-cart',C.id)}catch(e){}
  updateHud();updateQuest();
  if(!state.seenIntro&&C.intro){state.seenIntro=true;save();openDialog('안내',says(C.intro))}
}
let menuSel=0;
function openMenu(suggest){
  $('toast').hidden=true;
  if(dlg)closeDialog();
  menuSel=typeof suggest==='number'?suggest:Math.max(0,CARTRIDGES.indexOf(C));
  $('cartTitle').textContent=typeof suggest==='number'?'다음 편이 기다려요!':'카트리지';
  $('cartList').innerHTML=CARTRIDGES.map((c,i)=>{
    let got=0;try{got=(JSON.parse(localStorage.getItem(c.save)||'{}').badges||[]).length}catch(e){}
    return `<button class="cart" data-i="${i}"><span class="lab" style="background:${c.color}">${c.n}</span><span class="info"><div class="t">${c.title}${c===C?'<small>지금</small>':''}</div><div class="d">배지 ${got}/${c.words.length} · ${c.words.map(w=>w[0]).join(' · ')}</div></span></button>`}).join('');
  $('cartList').querySelectorAll('.cart').forEach(b=>{
    b.addEventListener('pointerdown',()=>{menuSel=+b.dataset.i;markMenu()});
    b.addEventListener('click',()=>pickCart(+b.dataset.i));
  });
  $('cartPanel').hidden=false;markMenu();
}
function markMenu(){$('cartList').querySelectorAll('.cart').forEach((b,i)=>{b.classList.toggle('sel',i===menuSel);if(i===menuSel)b.focus({preventScroll:true})})}
function moveMenu(d){const n=CARTRIDGES.length;menuSel=(menuSel+d+n)%n;markMenu();sfx('move')}
function closeMenu(){$('cartPanel').hidden=true}
function pickCart(i){closeMenu();const c=CARTRIDGES[i];if(c!==C){boot(c.id);sfx('cart')}}

/* ---------- input ---------- */
function dir(d){ // a D-pad press, wherever the focus is
  if(menuOpen()){moveMenu(d==='up'||d==='left'?-1:1);return true}
  if(choosing()){moveSel(d==='up'||d==='left'?-1:1);return true}
  return false;
}
document.querySelectorAll('.dpad button').forEach(b=>{
  const on=e=>{e.preventDefault();b.classList.add('on');const d=b.dataset.d;if(dir(d))return;held=d;if(dlg)return;tryMove()};
  const off=()=>{b.classList.remove('on');if(held===b.dataset.d)held=null};
  b.addEventListener('pointerdown',e=>{b.setPointerCapture?.(e.pointerId);on(e)});
  b.addEventListener('pointerup',off);b.addEventListener('pointercancel',off);b.addEventListener('lostpointercapture',off);
});
$('btnA').addEventListener('pointerdown',e=>{e.preventDefault();interact()});
$('btnB').addEventListener('pointerdown',e=>{e.preventDefault();cancel()});
$('dlg').addEventListener('click',e=>{const w=e.target.closest('.txt .w');if(w){e.stopPropagation();showWord(w.textContent);return}advance()});
$('gloss').addEventListener('click',e=>{ // tap the definition to keep it (× closes); B closes too
  if(e.target.closest('.gx')){hideGloss();return}if(e.target.closest('.q'))return;
  clearTimeout(showWord.t);$('gloss').classList.add('pinned')});
$('enToggle').addEventListener('click',()=>$('panel').classList.toggle('en'));
$('choices').addEventListener('pointerdown',e=>{const b=e.target.closest('.choice');if(b){sel=choiceBtns().indexOf(b);markSel()}});
$('talkBtn').addEventListener('click',openTalk);
$('tapBtn').addEventListener('click',openTaps);$('tapClose').addEventListener('click',closeTaps);
$('tapSortT').addEventListener('click',()=>{tapSort='t';openTaps()});$('tapSortN').addEventListener('click',()=>{tapSort='n';openTaps()});
$('tapPanel').addEventListener('click',e=>{if(e.target.id==='tapPanel'){closeTaps();return}const p=e.target.closest('.tp');if(p){const en=p.querySelector('.tpe');en.hidden=!en.hidden}});$('talkClose').addEventListener('click',closeTalk);
$('talkPanel').addEventListener('click',e=>{if(e.target.id==='talkPanel'){closeTalk();return}const w=e.target.closest('.w');if(w)showWord(w.textContent)});
$('badgeBtn').addEventListener('click',openPanel);
$('cartMi').addEventListener('click',openMenu);
/* START: everything that isn't the game itself */
/* 문제 알리기: a report goes to the word-reports inbox on seldoncortex.com (same inbox as 성실호, 형제, 방과 후).
   Artifacts can't call other sites, so 보내기 is a plain link carrying the report after the #; the page there posts it once. */
const REPORT_URL='https://seldoncortex.com/word-reports/';let lastLines=[],repKind='game',lastWord='';
function reportCtx(){
  const q=C.quest?C.quest():null;
  return {chapter:C.title||C.id,place:C.id,pos:player.x+','+player.y,objective:q?q.text:'',
    line:dlg&&dlg.cur?lastLines[lastLines.length-1]:'',lines:lastLines.join('\n'),word:lastWord}
}
function reportHref(){
  const r={game:'daneo-maul',kind:repKind,note:$('repNote').value.trim().slice(0,1000),build:String(C.id),ctx:reportCtx()};
  const b=new TextEncoder().encode(JSON.stringify(r));let bin='';b.forEach(x=>bin+=String.fromCharCode(x));
  return REPORT_URL+'#'+btoa(bin).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
}
function openReport(){
  if(!$('repPanel')){
    const P=document.createElement('div');P.className='panel';P.id='repPanel';P.hidden=true;
    P.innerHTML=`<div class="sheet talksheet" role="dialog" aria-label="문제 알리기"><h2><span>문제 알리기</span><button class="btn" id="repClose">닫기</button></h2>
     <div class="tapsort"><button class="btn" id="repGame">게임이 이상해요</button><button class="btn" id="repKo">한국어가 이상해요</button></div>
     <div id="repCtx" style="font-size:.85rem;opacity:.75;white-space:pre-wrap;overflow-wrap:anywhere;margin:8px 0"></div>
     <textarea id="repNote" rows="3" maxlength="1000" placeholder="무엇이 이상해요?" style="width:100%;box-sizing:border-box;font:inherit;padding:8px;border-radius:8px"></textarea>
     <div style="display:flex;justify-content:flex-end;margin-top:8px"><a class="btn" id="repSend" target="_blank" rel="noopener" style="text-decoration:none">보내기</a></div></div>`;
    document.body.append(P);
    P.addEventListener('click',e=>{if(e.target===P)closeReport()});$('repClose').addEventListener('click',closeReport);
    $('repGame').addEventListener('click',()=>setRepKind('game'));$('repKo').addEventListener('click',()=>setRepKind('korean'));
    $('repNote').addEventListener('input',()=>{$('repSend').href=reportHref()});
    $('repSend').addEventListener('click',()=>{$('repSend').href=reportHref();setTimeout(()=>{closeReport();$('repNote').value='';toast('고마워요!')},300)});
  }
  const c=reportCtx();$('repCtx').textContent=[c.chapter,c.line||lastLines[lastLines.length-1]||'',c.word?'단어: '+c.word:''].filter(Boolean).join('\n');
  setRepKind(repKind);$('repPanel').hidden=false;document.body.classList.add('talkopen');hideGloss();
}
function setRepKind(k){repKind=k;$('repGame').classList.toggle('on',k==='game');$('repKo').classList.toggle('on',k==='korean');$('repSend').href=reportHref()}
function closeReport(){$('repPanel').hidden=true;document.body.classList.remove('talkopen')}
function toggleStart(){const P=$('startPanel');if(P.hidden&&panelOpen())return;P.hidden=!P.hidden;hideGloss()}
$('repBtn').addEventListener('click',()=>{$('startPanel').hidden=true;openReport()});
$('startBtn').addEventListener('click',toggleStart);$('startClose').addEventListener('click',()=>$('startPanel').hidden=true);
$('startPanel').addEventListener('click',e=>{if(e.target.id==='startPanel'){$('startPanel').hidden=true;return}
  const mi=e.target.closest('.mi');if(mi&&!mi.classList.contains('toggle'))$('startPanel').hidden=true},true);  // capture: close the menu before the item opens its panel
/* 뉴스 출처: the real news a cartridge is based on (C.sources = [[Korean headline, url, site], …]) */
function openSources(){const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  $('srcList').innerHTML=(C.sources||[]).map(([t,u,site])=>`<li><a href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(t)}</a><small>${esc(site)}</small></li>`).join('');$('srcPanel').hidden=false}
$('srcBtn').addEventListener('click',openSources);
$('linkBtn').addEventListener('click',async()=>{const n=C.id.replace(/\D/g,''),u='https://stan-stani.github.io/daneo-maul/?편='+n;
  try{await navigator.clipboard.writeText(u);toast(C.n+' 링크를 복사했어요!')}catch(e){prompt(C.n+' 링크',u)}});$('srcClose').addEventListener('click',()=>$('srcPanel').hidden=true);
$('srcPanel').addEventListener('click',e=>{if(e.target.id==='srcPanel')$('srcPanel').hidden=true});
$('cartClose').addEventListener('click',closeMenu);
$('cartPanel').addEventListener('click',e=>{if(e.target.id==='cartPanel')closeMenu()});
$('sndBtn').addEventListener('click',()=>{soundOn=!soundOn;try{localStorage.setItem('daneo-maul-sound',soundOn?'1':'0')}catch(e){}updateSound();sfx('ok')});
$('closePanel').addEventListener('click',()=>$('panel').hidden=true);
$('panel').addEventListener('click',e=>{if(e.target.id==='panel')$('panel').hidden=true});
$('resetBtn').addEventListener('click',()=>{
  /* start over: stop whatever is on screen, wipe this cartridge's save and log, then play the intro again */
  gen++;offerNext=false;pendingCelebrate=null;held=null;
  if(dlg){dlg=null;clearInterval(typing?.id);$('dlg').hidden=true}
  hideGloss();$('panel').hidden=true;$('toast').hidden=true;
  try{localStorage.removeItem(C.save);localStorage.removeItem(C.save+'-talk')}catch(e){}
  boot(C.id);sfx('cart');
});
document.addEventListener('contextmenu',e=>e.preventDefault());
/* stop the phone's long-press gesture (the delayed buzz) on the controls; pointer events still fire */
document.querySelector('.pad').addEventListener('touchstart',e=>{if(e.cancelable)e.preventDefault()},{passive:false});
const KEYS={ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',w:'up',s:'down',a:'left',d:'right'};
addEventListener('keydown',e=>{
  if(e.target.closest&&e.target.closest('textarea,input'))return;  // typing a note, not playing
  if(KEYS[e.key]){e.preventDefault();if(dir(KEYS[e.key]))return;held=KEYS[e.key];return}
  if(choosing()&&/^[1-4]$/.test(e.key)){const b=choiceBtns()[+e.key-1];if(b){e.preventDefault();b.click()}return}
  if([' ','Enter','z','Z'].includes(e.key)){e.preventDefault();if(!e.repeat)interact();return}
  if(['x','X','Escape'].includes(e.key)){e.preventDefault();cancel()}
});
addEventListener('keyup',e=>{if(KEYS[e.key]===held)held=null});

/* ---------- start: newest cartridge ---------- */
updateSound();
let lastCart=null;try{lastCart=localStorage.getItem('daneo-maul-cart')}catch(e){}
/* a link can open a given cartridge: ?편=3 (or ?cart=3, ?cart=c3, #3편) */
function linkedCart(){
  const q=new URLSearchParams(location.search),v=q.get('편')||q.get('cart')||decodeURIComponent(location.hash.slice(1));
  const n=(String(v||'').match(/\d+/)||[])[0];return n&&CARTRIDGES.find(c=>c.id==='c'+n)?'c'+n:null;
}
boot(linkedCart()||(CARTRIDGES.some(c=>c.id===lastCart)?lastCart:CARTRIDGES[0].id)); // a link wins; else first visit 1편, after that the cartridge last played
requestAnimationFrame(loop);
</script>
</body></html>

</body></html>
</body></html>