  if(state.stage===1){const n=done();return n<SOURCES.length?{text:`🍂 축제 사람들을 도와요! ${n}/${SOURCES.length}`}:{late:true,text:'🏹 다 도와줬어요! 진행자한테 말해요.'}}
  if(state.stage===2)return {late:true,text:'🎯 양궁장 ✕ 표시에 서세요. 대회 시작!'};
  return null;
 },
