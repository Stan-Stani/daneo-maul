<script>
/* =====================================================================
   카트리지 4편 · 체육관과 수리점
   Content only — the engine draws, moves and runs dialogue. (Format notes: see 1편.)
   Story: beat the gym leader → badge + a technical machine that turns out to be broken →
   fill in the repair form → the repairer fixes it → back to the leader for one last chance.
   state.stage: 0 start · 1 machine broken · 2 form written · 3 repaired · 4 done
   ===================================================================== */
(()=>{
const LEADER=[
 {w:'배지',ask:'관장을 이기면 받아요. 옷에 다는 작고 예쁜 거예요. 이건 ___예요.',opts:[['배지',1],['머신',0,'머신은 기계예요. 옷에 다는 작은 거 → "배지".'],['기회',0,'기회는 좋은 때예요. 옷에 다는 작은 거 → "배지".']]},
 {w:'배지',ask:'포켓몬 리그에 가려면 체육관 ___가 여덟 개 있어야 돼요.',opts:[['배지',1],['머신',0,'머신은 기술을 가르쳐요. 리그에 가려면 "배지" 여덟 개!']]},
 {w:'머신',ask:'"기술 머신"으로 뭐 해요?',opts:[['포켓몬한테 새 기술을 가르쳐요.',1],['포켓몬을 회복해요.',0,'회복은 포켓몬 센터에서 해요. 기술 머신은 새 기술을 가르쳐요.']]},
 {w:'머신',ask:'"머신"은 영어 machine이에요. 한국어로 하면 ___예요.',opts:[['기계',1],['기술',0,'기술은 하는 방법이에요. machine → "기계".'],['기회',0,'기회는 chance예요. machine → "기계".']]},
 {w:'기회',ask:'이번이 처음이에요. 다음은 없어요. 처음이자 마지막 ___예요!',opts:[['기회',1],['기계',0,'소리가 비슷해요! 기계는 machine이에요. 좋은 때 → "기회".'],['기술',0,'기술은 하는 방법이에요. 좋은 때 → "기회".']]},
 {w:'기회',ask:'"처음이자 마지막"은 무슨 뜻이에요?',opts:[['처음이에요. 그리고 다시는 없어요.',1],['처음이에요. 다음에 또 있어요.',0,'"-이자"는 "-이고, 또"예요. 처음이고 또 마지막이에요. 다시는 없어요!']]},
 {w:'기회',ask:'좋은 기회가 왔어요. 이 기회를 ___ 마세요!',opts:[['놓치지',1],['지키지',0,'기회는 "놓치다"하고 같이 써요. 기회를 놓치지 마세요!']]},
];
const DESK=[
 {w:'작성하다',ask:'종이에 이름하고 전화번호를 써요. 신청서를 ___.',opts:[['작성해요',1],['대체해요',0,'대체하다는 다른 걸로 바꿔요. 서류를 써요 → "작성해요".'],['개명해요',0,'개명은 이름을 바꿔요. 서류를 써요 → "작성해요".']]},
 {w:'작성하다',ask:'"이것을 다 작성해 주실래요?" 무슨 뜻이에요?',opts:[['이걸 다 써 주세요.',1],['이걸 다 읽어 주세요.',0,'작성하다는 "쓰다"예요. 읽다가 아니에요. "다 써 주세요".']]},
 {w:'작성하다',ask:'"작성하다"는 보통 뭐하고 같이 써요?',opts:[['신청서, 보고서, 이메일',1],['집, 밥, 이름',0,'그건 "짓다"예요! 서류, 글 → "작성하다".']]},
];
const FIX=[
 {w:'고장 나다',ask:'머신이 안 켜져요. 머신이 ___.',opts:[['고장 났어요',1],['떨어졌어요',0,'떨어지다는 아래로 가요. 기계가 안 돼요 → "고장 났어요".'],['비싸졌어요',0,'비싸지다는 값이 올라가요. 기계가 안 돼요 → "고장 났어요".']]},
 {w:'고장 나다',ask:'감기에 걸렸어요. 사람한테도 "고장 났어요"라고 해요?',opts:[['아니요, 사람은 "아파요".',1],['네, 사람도 고장 나요.',0,'"고장 나다"는 기계, 물건에 써요. 사람은 "아파요". (농담으로는 써요 😄)']]},
 {w:'수리하다',ask:'고장 난 컴퓨터를 고쳐요. 컴퓨터를 ___.',opts:[['수리해요',1],['작성해요',0,'작성하다는 글을 써요. 고쳐요 → "수리해요".'],['심어요',0,'😄 컴퓨터는 땅에 안 심어요! 고쳐요 → "수리해요".']]},
 {w:'수리하다',ask:'"수리하다"하고 뜻이 비슷한 말은?',opts:[['고치다',1],['짓다',0,'짓다는 새로 만들어요. 고장 난 걸 다시 되게 해요 → "고치다".']]},
 {w:'대체하다',ask:'헌 부품 대신 새 부품을 써요. 헌 부품을 새 부품으로 ___.',opts:[['대체해요',1],['개선해요',0,'개선하다는 더 좋게 해요. 다른 걸로 바꿔요 → "대체해요".'],['개명해요',0,'개명은 이름만 바꿔요! 부품을 바꿔요 → "대체해요".']]},
 {w:'대체하다',ask:'"교실에서 선생님을 컴퓨터로 대체할 수 없어요." 무슨 뜻이에요?',opts:[['컴퓨터가 선생님 대신 할 수 없어요.',1],['컴퓨터가 선생님을 도와줄 수 없어요.',0,'대체하다는 "대신하다"예요. 컴퓨터는 선생님 "대신" 못 해요.']]},
];
const go=n=>()=>{state.stage=n};

CARTRIDGES.push({
 id:'c4', n:'4편', title:'체육관과 수리점', color:'#8E7CC3', save:'daneo-maul-v4',
 words:[['배지','badge'],['머신','machine (TM)'],['기회','chance'],['작성하다','to write up'],['고장 나다','to break down'],['수리하다','to repair'],['대체하다','to replace'],['짓다','to build'],['심다','to plant'],['비싸지다','to get pricier'],['두다','to put, leave'],['개명하다',"to change one's name"]],
 start:{x:12,y:9,dir:'down'},
 fresh:{stage:0},
 help:'사람 앞에서 <b>A</b>. 머리 위 <span class="k">!</span> 새 단어 · <span class="k">?</span> 복습해서 <span class="k">★</span> 받기',
 tips:['<b>기회</b>: 좋은 때 (chance) · <b>기계</b>: machine · <b>기술</b>: 하는 방법','집을 <b>지어요</b> · 나무를 <b>심어요</b> · 강아지가 <b>짖어요</b>','탁자에 <b>둬요</b> = 탁자에 <b>놓아요</b> · 주머니에 <b>넣어요</b>','<b>고장 나다</b>: 기계, 물건 · <b>아프다</b>: 사람','<b>대체하다</b>: 다른 걸로 바꿔요 · <b>개선하다</b>: 더 좋게 해요','-아/어<b>지다</b>: 비싸<b>졌어요</b>, 추워<b>졌어요</b> (변했어요)','<b>개명</b>(改名): 이름을 바꿔요 · <b>작성</b>: 서류를 써요'],
 intro:['단어 마을 4편! 오늘은 체육관과 수리점이에요. 🏟️🔧','관장을 이기면 배지를 받아요. 먼저 체육관에 가 보세요.','! 가 있는 사람한테 배지가 있어요. 한 번에 다 맞히면 ★ 예요.'],
 done:['축하해요! 배지 열두 개를 다 모았어요! 🎉','배지, 머신, 기회, 작성하다, 고장 나다, 수리하다, 대체하다, 짓다, 심다, 비싸지다, 두다, 개명하다!','? 가 있는 사람한테 다시 말해 보세요. 한 번에 맞히면 ★ 예요.'],
 perfect:['★ 열두 개! 모든 단어가 완벽해요!','처음이자 마지막 기회…? 아니에요, 또 놀러 오세요! 😄'],

 quest(){
  if(state.stage===0)return {text:'🏟️ 체육관에 가서 관장을 만나 보세요.'};
  if(state.stage===1)return {late:true,text:'🔧 머신이 고장 났어요! 수리점에서 신청서를 작성해요.'};
  if(state.stage===2)return {text:'🔧 수리 기사님한테 머신을 보여 주세요.'};
  if(state.stage===3)return {text:'🏟️ 머신을 고쳤어요! 관장한테 다시 가요. 마지막 기회예요!'};
  return null;
 },

