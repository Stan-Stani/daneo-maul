   ?[{say:'끼잉… 🐶 (메지 상태가 안 좋아요.)'},{say:'빨리 포켓몬 센터에 가요!'}]
   :state.stage===3
   ?[{say:'멍멍! 🐶 메지가 다 회복했어요!'},{say:'메지가 짖으면서 꼬리를 흔들어요. 기분이 좋아요.'}]
   :[{say:'멍멍! 🐶 (메지가 꼬리를 흔들어요.)'},{say:'메지가 당신을 잘 따라요!'}],
 },

