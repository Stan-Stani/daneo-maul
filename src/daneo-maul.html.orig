   {ask:'심판은 어떤 사람이에요? 규칙을 ___ 사람이에요.',opts:[['지키게 하는',1],['물어보는',0,'심판은 묻는 사람이 아니에요. 규칙을 "지키게 하는" 사람이에요.']]},
   {ask:'"규칙을 따라요"하고 "규칙을 지켜요", 뜻이 비슷해요?',opts:[['네, 비슷해요.',1],['아니요, 반대예요.',0,'반대 아니에요! 둘 다 규칙대로 해요. 비슷해요.']]},
