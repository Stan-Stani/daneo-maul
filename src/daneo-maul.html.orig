 {id:'editor',name:'편집장',x:4,y:3,dir:'down',still:1,look:{hair:'#2B1E1A',skin:'#F3D0B0',shirt:'#3E7F78',pants:'#2E3548',long:1},badge:['기자','취재하다'],
