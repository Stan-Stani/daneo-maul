 npcs:[
 {id:'prof',name:'오박사',x:6,y:4,dir:'down',look:{hair:'#9A9AA3',skin:'#F1C9A5',shirt:'#F4F4F4',pants:'#6B4A2B'},badge:['박사','연구'],
  after:'메지는 잘 지내요? 연구 결과가 기대돼요. 📓',
  pool:PROF,
